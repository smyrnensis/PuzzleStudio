{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PuzzleStudio",
  "version": "0.1.0",
  "identifier": "dev.puzzlestudio.editor",
  "build": {
    "frontendDist": "../crates/html_editor/static"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PuzzleStudio",
        "url": "editor.html",
        "width": 1440,
        "height": 960,
        "minWidth": 1100,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
