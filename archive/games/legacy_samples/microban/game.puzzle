title Microban

assets {
	css "game.css"
}

const start_message = "Push every box onto a goal."
const final_message = "All Microban levels clear"

audio {
	sfx push seed=boxpush01 type=hit
	sfx clear seed=clear01 type=jump
	music music_name seed=test1 tone=0 bpm=100 volume=0.5
}

model puzzle sokoban {
	layers {
		floor = Goal
		solid = Player Box Wall
	}

	var box_moved = false
input resume

	win_conditions {
		some Goal
		all Goal on Box
	}

	rules {
		once [ Player ] -> set box_moved = false
		once input directions [ Player | Box | no solid ] -> [ | Player | Box ] set box_moved = true
		once input directions [ Player | no solid ] -> [ | Player ]
	}
}

levels microban of sokoban {
	legend {
		. = empty
		G = Goal
		P = Player
		B = Box
		# = Wall
		* = Goal Box
		+ = Goal Player
	}

	level microban_01
		####..
		#.G#..
		#..###
		#*P..#
		#..B.#
		#..###
		####..

	level microban_02
		######
		#....#
		#.#P.#
		#.B*.#
		#.G*.#
		#....#
		######

	level microban_03
		..####...
		###..####
		#.....B.#
		#.#..#B.#
		#.G.G#P.#
		#########

	level microban_04
		########
		#......#
		#.G**BP#
		#......#
		#####..#
		....####

	level microban_05
		.#######
		.#.....#
		.#.GBG.#
		##.BPB.#
		#..GBG.#
		#......#
		########

	level microban_06
		######.#####
		#....###...#
		#.BB.....#P#
		#.B.#GGG...#
		#...########
		#####.......

	level microban_07
		#######
		#.....#
		#.GBG.#
		#.BGB.#
		#.GBG.#
		#.BGB.#
		#..P..#
		#######

	level microban_08
		..######
		..#.GGP#
		..#.BB.#
		..##.###
		...#.#..
		...#.#..
		####.#..
		#....##.
		#.#...#.
		#...#.#.
		###...#.
		..#####.

	level microban_09
		#####.
		#G..##
		#PBB.#
		##...#
		.##..#
		..##G#
		...###

	level microban_10
		......#####
		......#G..#
		......#G#.#
		#######G#.#
		#.P.B.B.B.#
		#.#.#.#.###
		#.......#..
		#########..
}

scene title {
	title "Microban"
	subtitle "Levels by David Skinner"
	button "Continue" -> continue levels in playing
	button "New Game" -> start levels in playing
	button "Level Select" -> goto level_select
	on_scene_start {
		stop_music music_name
	}
}

scene playing {
	state {
		board = puzzle sokoban
	}
	view {
		row {
			title "Microban"
			subtitle "Levels by David Skinner"
			subtitle board.level.label
		}
		puzzle board
	}
	keys {
		q Escape -> goto level_select
	}
	on_scene_start {
		play_music music_name
		if board.level.name == microban.microban_01 {
			message start_message
		}
	}
	rules {
	board.rules
	}
	if board.win_conditions and board.level.last {
		sfx clear
		message final_message
		stop_music music_name
		goto level_select
	}
	if board.win_conditions {
		sfx clear
		playing.next_level
	}
	if board.box_moved {
		sfx push
	}
}

scene menu {
	view {
		text "Menu"
		column {
			button "Resume" -> input resume
			button "Restart" -> playing.restart
			button "Level Select" -> goto level_select
		}
	}
	keys {
		Escape Enter Space -> input resume
		q -> goto level_select
	}
	rules {
		if input == resume -> {
			resume_music music_name
			back
		}
	}
}

scene level_select {
	view {
		text "Select a level"
		level_menu {
			show_index = false
			show_solved = true
		}
	}
	keys {
		q Escape -> goto title
	}
	on_scene_start {
		stop_music music_name
	}
}
