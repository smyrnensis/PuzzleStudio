}

scene title {
  title "Smother"
  subtitle "by Team Borse"
  button "Play" ->
    sfx startgame
    start levels in playing
  end
  keys {
    Enter Space x ->
      sfx startgame
      start levels in playing
    end
  }
}

scene playing {
  state {
    board = puzzle main
  }
  view {
    row {
      title "Smother"
    }
    puzzle board
  }
  keys {
    w ArrowUp -> input up
    s ArrowDown -> input down
    a ArrowLeft -> input left
    d ArrowRight -> input right
    r -> board.restart
    Escape -> goto title
  }
  rules {
    board.rules
    if board.win_conditions -> {
      board.next_level
    }
  }
}
