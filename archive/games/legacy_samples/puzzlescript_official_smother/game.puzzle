title Smother
author "Team Borse"

theme puzzlescript {
  background_color #9CBD0F
  text_color #0F380F
}

audio {
  sfx startgame seed=83279102 type=puzzlescript
  sfx CloseMessage seed=123434 type=puzzlescript
  sfx ShowMessage seed=123434 type=puzzlescript
  sfx sfx0 seed=8545502 type=puzzlescript
  sfx sfx1 seed=26 type=puzzlescript
}

model puzzle main {
layers {
  layer_1 = Background
  layer_2 = LaserV LaserH LaserB
  layer_3 = Exit
  layer_4 = ProtectorSolo Heart Wall
  layer_5 = PlayerFull Protector ProtectorSolo victimSolo Wall PlayerDead LaserGV LaserGH pushBlock
}

group {
  Player = PlayerFull Protector ProtectorSolo victimSolo
  PlayerWin = PlayerFull PlayerDead Protector victimSolo
  Laser = LaserV LaserH LaserB
  LaserBlock = Wall Player PlayerDead Exit
}

sprites {
  Background
    #9CBD0F

  LaserGV
    #9CBD0F #8CAD0F #306230 #0F380F
    22222
    .222.
    ..3..
    ..3..
    .....

