    .323.
    .222.
    .222.
    .2.2.

  Protector
    #9CBD0F #8CAD0F #306230 #0F380F
    .333.
    .232.
    .333.
    .333.
    .3.3.

  ProtectorSolo
    #9CBD0F #8CAD0F #306230 #0F380F
    .333.
    .232.
    .333.
    .333.
    .3.3.

  victimSolo
    #9CBD0F #8CAD0F #306230 #0F380F
    .222.
    .323.
    .222.
    .222.
    .2.2.

  PlayerDead
    #9CBD0F #8CAD0F #306230 #0F380F
    .222.
    22222
    2.2.2
    .222.
    .222.

  pushBlock
    #9CBD0F #8CAD0F #306230 #0F380F
    33333
    31113
    31113
    31113
    33333
}

legend {
  . = Background
  # = Wall
  g = LaserGV
  h = LaserGH
  P = PlayerFull
  p = PlayerFull
  n = Protector
  q = ProtectorSolo
  k = victimSolo
  O = Exit
  o = Exit
  l = Heart
  b = pushBlock
  _ = empty
}

win_conditions {
  all PlayerWin on Exit
  no Heart
}

routine __ps_main once {
  [ victimSolo{>} | pushBlock ] -> [ victimSolo{>} | pushBlock{>} ]
  [ pushBlock Laser ] -> [ Wall ]
  [ ProtectorSolo{>} | ... | Heart ] -> [ | ... | ProtectorSolo ] sfx sfx1
  [ ProtectorSolo{>} ] -> [ ProtectorSolo ]
  move
  [ Laser ] -> [ ]
  down [ LaserGV | no Laser ] -> [ LaserGV | LaserV ]
  right [ LaserGH | no Laser ] -> [ LaserGH | LaserH ]
  down [ LaserV no LaserBlock | ] -> [ LaserV | LaserV ]
  right [ LaserH no LaserBlock | ] -> [ LaserH | LaserH ]
  down [ LaserV no LaserBlock | LaserH ] -> [ LaserV | LaserB ]
  down [ LaserGV no LaserBlock | LaserH ] -> [ LaserGV | LaserB ]
  right [ LaserH no LaserBlock | LaserV ] -> [ LaserH | LaserB ]
  right [ LaserGH no LaserBlock | LaserV ] -> [ LaserGH | LaserB ]
  right [ LaserB no LaserBlock | no Laser ] -> [ LaserB | LaserH ]
  right [ LaserH no LaserBlock | no Laser ] -> [ LaserH | LaserH ]
  down [ LaserB no LaserBlock | no Laser ] -> [ LaserB | LaserV ]
  down [ LaserV no LaserBlock | no Laser ] -> [ LaserV | LaserV ]
  [ PlayerFull Laser ] -> [ PlayerDead Laser ] sfx sfx0
  [ victimSolo Laser ] -> [ PlayerDead Laser ] sfx sfx0
}

on_level_start {
  once_all [ no Background ] -> [ Background ]
  __ps_main
}

rules {
  input directions [ Player ] -> [ Player{>} ]
  __ps_main
}

