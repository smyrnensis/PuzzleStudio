title "Simple Block Pushing Game"
author "David Skinner"
homepage "www.puzzlescript.net"

theme puzzlescript

model puzzle main {
layers {
  layer_1 = Background
  layer_2 = Target
  layer_3 = Player Wall Crate
}

sprites {
  Background
    #90ee90 #008000
    11111
    01111
    11101
    11111
    10111

  Target
    #00008b
    .....
    .000.
    .0.0.
    .000.
    .....

  Wall
    #a46322 #493c2b
    00010
    11111
    01000
    11111
    00010

  Player
    #000000 #ffa500 #ffffff #0000ff
    .000.
    .111.
    22222
    .333.
    .3.3.

  Crate
    #ffa500
    00000
    0...0
    0...0
    0...0
    00000
}

legend {
  . = Background
  # = Wall
  P = Player
  * = Crate
  @ = Crate Target
  O = Target
  _ = empty
}

win_conditions {
  all Target on Crate
}

on_level_start {
  once_all [ no Background ] -> [ Background ]
}

rules {
  input directions [ Player ] -> [ Player{>} ]
  [ Player{>} | Crate ] -> [ Player{>} | Crate{>} ]
  move
}

levels {
  #################
  #########....P.##
  #########.*#*.###
  #########.*..*###
  ##########*.*.###
  #########.*.#*###
  #OOOO..##.*.*...#
  ##OOO....*......#
  #OOOO..##########
  #################
}
}

scene title {
  title "Simple Block Pushing Game"
  subtitle "by David Skinner"
  button "Play" -> start levels in playing
  keys {
    Enter Space x -> start levels in playing
  }
}

scene playing {
  state {
    board = puzzle main
  }
  view {
    row {
      title "Simple Block Pushing Game"
    }
    puzzle board
  }
  keys {
    w ArrowUp -> input up
    s ArrowDown -> input down
    a ArrowLeft -> input left
    d ArrowRight -> input right
    r -> board.restart
    Escape -> goto title
  }
  rules {
    board.rules
    if board.win_conditions -> {
      board.next_level
    }
  }
}
