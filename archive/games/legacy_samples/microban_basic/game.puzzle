title MicrobanBasic

var start_message = "Push every box onto a goal."
var final_message = "All Microban levels clear"

audio {
	sfx push seed=boxpush01 type=hit
	sfx clear seed=clear01 type=jump
	music music_name seed=test1 tone=0 bpm=105 volume=0.5
}

model puzzle sokoban {
	layers {
		floor = @Floor
		target = Goal
		solid = Player Box Wall
	}

	win_conditions {
		some Goal
		all Goal on Box
	}

	var box_moved = false

	import "sprites.puzzle"

	on_level_start {
		display [ no @Floor ] -> [ @Floor ]
	}

	rules {
		once [ Player ] -> set box_moved = false
		once input directions [ Player | Box | no solid ] -> [ | Player | Box ] set box_moved = true
		once input directions [ Player | no solid ] -> [ | Player ]
	}

	import "levels.puzzle"
}

import "menus/title.puzzle"

scene playing {
	view {
		row {
			title "Microban Basic"
			subtitle "Levels by David Skinner"
			subtitle board.level.label
		}
		board = puzzle sokoban
	}
	keys {
		Escape q -> input quit
	}
	on_scene_start {
		play_music music_name
		if board.level.name == microban_01 {
			message start_message
		}
	}
	rules {
		board.rules
		if input == quit -> {
			stop_music music_name
			goto level_select
		}
		if board.win_conditions and board.level.last -> {
			sfx clear
			message final_message
			stop_music music_name
			goto level_select
		}
		if board.win_conditions -> {
			sfx clear
			wait 0.35s
			board.next_level
		}
		if board.box_moved -> {
			sfx push
		}
	}
}

import "menus/level_select.puzzle"
