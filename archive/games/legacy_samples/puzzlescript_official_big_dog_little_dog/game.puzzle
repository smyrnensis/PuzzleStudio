}

scene title {
  title "Big dog and little dog (test version)"
  subtitle "by increpare"
  inputs {
    confirm <- Enter Space x
  }
  button "Play" -> input confirm
  rules {
    if input == confirm -> start levels in playing
  }
}

scene playing {
  state {
    board = puzzle main
  }
  view {
    row {
      title "Big dog and little dog (test version)"
    }
    puzzle board
  }
  inputs {
    back <- Escape q
  }
  rules {
    board.rules
    if input == back -> goto title
    if board.win_conditions -> {
      board.next_level
    }
  }
}
