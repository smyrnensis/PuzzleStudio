title "Mini-EGG"
author increpare
homepage "www.increpare.net"

theme puzzlescript

model puzzle main {
layers {
  layer_1 = Background
  layer_2 = Target
  layer_3 = Player_u Player_d Player_l Player_r player_c Wall Crate
  layer_4 = processed
}

groups {
  player = Player_u Player_d Player_l Player_r player_c
  obstacle = Crate Wall
}

sprites {
  Background
    #90ee90 #008000
    11111
    01111
    11101
    11111
    10111

  Target
    #00008b
    .....
    .000.
    .0.0.
    .000.
    .....

  Wall
    #a46322 #493c2b
    00010
    11111
    01000
    11111
    00010

  Crate
    #add8e6
    00000
    0...0
    0...0
    0...0
    00000

  Player_u
    #ffa500 #a46322
    ..0..
    .000.
    10000
    11000
    .111.

  Player_d
    #ffa500 #a46322
    .000.
    10000
    11000
    .110.
    ..1..

  Player_l
    #ffa500 #a46322
    ..00.
    .0000
    00000
    .1111
    ..11.

  Player_r
    #ffa500 #a46322
    .00..
    0000.
    00000
    1111.
    .11..

  player_c
    #ffa500 #a46322
    ..0..
    .000.
    11000
    .110.
    ..1..

  processed
    #ff0000
}

legend {
  . = Background
  # = Wall
  P = player_c
  * = Crate
  @ = Crate Target
  O = Target
  o = Target
  _ = empty
}

win_conditions {
  all Target on Crate
}

on_level_start {
  once_all [ no Background ] -> [ Background ]
}

rules {
  input directions [ player ] -> [ player{>} ]
  [ player{>} | Wall ] -> cancel
  [ player{>} | Crate | obstacle ] -> cancel
  [ Player_u{up} no processed ] -> cancel
  [ Player_u{down} no processed ] -> [ player_c{down} processed ]
  [ Player_u{left} no processed ] -> [ Player_u{left} processed ]
  [ Player_u{right} no processed ] -> [ Player_u{right} processed ]
  [ Player_d{up} no processed ] -> [ player_c{up} processed ]
  [ Player_d{down} no processed ] -> cancel
  [ Player_d{left} no processed ] -> [ Player_d{left} processed ]
  [ Player_d{right} no processed ] -> [ Player_d{right} processed ]
  [ Player_l{up} no processed ] -> [ Player_l{up} processed ]
  [ Player_l{down} no processed ] -> [ Player_l{down} processed ]
  [ Player_l{left} no processed ] -> cancel
  [ Player_l{right} no processed ] -> [ player_c{right} processed ]
  [ Player_r{up} no processed ] -> [ Player_r{up} processed ]
  [ Player_r{down} no processed ] -> [ Player_r{down} processed ]
  [ Player_r{left} no processed ] -> [ player_c{left} processed ]
  [ Player_r{right} no processed ] -> cancel
  [ player_c{up} no processed ] -> [ Player_u{up} processed ]
  [ player_c{down} no processed ] -> [ Player_d{down} processed ]
  [ player_c{left} no processed ] -> [ Player_l{left} processed ]
  [ player_c{right} no processed ] -> [ Player_r{right} processed ]
  [ player{>} | Crate ] -> [ player{>} | Crate{>} ]
  [ processed ] -> [ ]
  move
}

levels {
  message "level 1 of 1"
  ####..
  #.O#..
  #..###
  #@P..#
  #..*.#
  #..###
  ####..
  message "EGG!"
}
}

scene title {
  title "Mini-EGG"
  subtitle "by increpare"
  button "Play" -> start levels in playing
  keys {
    Enter Space x -> start levels in playing
  }
}

scene playing {
  state {
    board = puzzle main
  }
  view {
    row {
      title "Mini-EGG"
    }
    puzzle board
  }
  keys {
    w ArrowUp -> input up
    s ArrowDown -> input down
    a ArrowLeft -> input left
    d ArrowRight -> input right
    r -> board.restart
    Escape -> goto title
  }
  rules {
    board.rules
    if board.win_conditions -> {
      board.next_level
    }
  }
}
