title sokoban_portal_microban

assets {
	css "game.css"
}

model puzzle portal_sokoban {
	rank = 1 2 3

	var progress = 0

	object Target 1
	object Portal:rank 1
	object Player 2
	object Box 2
	object Wall 2

	layers {
		floor = Target Portal:rank
		actor = Player Box Wall
	}

	groups {
		solid = actor
	}

	input return_hub

	enter_1 = progress == 0 and count([ Player Portal:1 ]) > 0
	enter_2 = progress == 1 and count([ Player Portal:2 ]) > 0
	enter_3 = progress == 2 and count([ Player Portal:3 ]) > 0
	parent_clear = progress == 3 and count([ Target no Box ]) == 0

	legend {
		. = empty
		# = Wall
		P = Player
		B = Box
		G = Target
		* = Target Box
		+ = Target Player
		1 = Portal:1
		2 = Portal:2
		3 = Portal:3
		a = Portal:1 Box
		b = Portal:2 Box
		c = Portal:3 Box
	}

	win_conditions {
		some Target
		all Target on Box
	}

	rules {
		if input == return_hub {
			if progress == 0 {
				once [ Player Portal:1 ] -> [ Player ] progress += 1
			}
			if progress == 1 {
				once [ Player Portal:2 ] -> [ Player ] progress += 1
			}
			if progress == 2 {
				once right [ Player Portal:3 | no solid ] -> [ Player | Box ] progress += 1
			}
		}
		for d in directions {
			if input == d {
				once d [ Player | Box | no solid ] -> [ | Player | Box ]
				once d [ Player | no solid ] -> [ | Player ]
			}
		}
	}

	levels {
		level hub
			#######
			#P1...#
			#..2..#
			#..3.G#
			#######

		level child_hub_01
			#######
			#P1...#
			#..2..#
			#..3.G#
			#######

		level child_hub_02
			#######
			#P1...#
			#..2..#
			#..3.G#
			#######

		level child_hub_03
			#######
			#P1...#
			#..2..#
			#..3.G#
			#######

		level one_move
			#######
			#P..BG#
			#.....#
			#######

	}
}

scene title {
	view {
		text "Sokoban Portal Microban"
		column {
				button "Start" -> input start
		}
	}
	keys {
		Enter Space -> input start
	}
	rules {
		if input == start -> {
			reset hub
			reset checkpoint
			hub.goto hub
		}
	}
}

scene checkpoint {
	view {
		board = puzzle portal_sokoban level hub
	}
}

scene child_checkpoint_1 {
	view {
		board = puzzle portal_sokoban level child_hub_01
	}
}

scene child_checkpoint_2 {
	view {
		board = puzzle portal_sokoban level child_hub_02
	}
}

scene child_checkpoint_3 {
	view {
		board = puzzle portal_sokoban level child_hub_03
	}
}

scene hub {
	view {
		row {
			title "sokoban_portal_microban"
			subtitle "Hub"
		}
		board = puzzle portal_sokoban level hub
	}
	keys {
		r -> input reset_hub
		q -> input quit
		Escape -> input open_menu
	}
	rules {
		board.rules
		if input == reset_hub -> copy checkpoint.board to hub.board
		if input == quit -> goto title
		if input == open_menu -> enter menu
		if board.parent_clear -> enter complete
		if board.enter_3 -> {
			reset child_checkpoint_3
			child_3.goto child_hub_03
		}
		if board.enter_2 -> {
			reset child_checkpoint_2
			child_2.goto child_hub_02
		}
		if board.enter_1 -> {
			reset child_checkpoint_1
			child_1.goto child_hub_01
		}
	}
}

scene child_1 {
	view {
		row {
			title "sokoban_portal_microban"
			subtitle "Child 1 Hub"
		}
		board = puzzle portal_sokoban
	}
	keys {
		r -> input reset_hub
		q -> input quit
		Escape -> input open_menu
	}
	rules {
		board.rules
		if input == reset_hub -> copy child_checkpoint_1.board to child_1.board
		if input == quit -> {
			copy checkpoint.board to hub.board
			goto hub
		}
		if input == open_menu -> enter menu
		if board.parent_clear -> {
			apply return_hub to hub.board
			copy hub.board to checkpoint.board
			goto hub
		}
		if board.enter_3 -> grandchild_1_3.goto one_move
		if board.enter_2 -> grandchild_1_2.goto one_move
		if board.enter_1 -> grandchild_1_1.goto one_move
	}
}

