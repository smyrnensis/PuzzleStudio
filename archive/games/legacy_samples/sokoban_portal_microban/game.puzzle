scene menu {
	view {
		text "Menu"
		column {
			button "Resume" -> back
				button "Hub" -> input hub
			button "Title" -> goto title
		}
	}
	keys {
		Escape Enter Space -> input resume
		q -> input hub
	}
	rules {
		if input == resume -> back
		if input == hub -> {
			copy checkpoint.board to hub.board
			goto hub
		}
	}
}

scene complete {
	view {
		text "Portal route complete"
		column {
			button "Title" -> goto title
		}
	}
	keys {
		Escape Enter Space -> input title
	}
	rules {
		if input == title -> goto title
	}
}
