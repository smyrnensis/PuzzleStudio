	}
	keys {
		r -> input restart
		q -> input quit
		Escape -> input open_menu
	}
	rules {
		board.rules
		if input == restart -> grandchild_1_1.goto level
		if input == quit -> {
			copy checkpoint.board to hub.board
			goto hub
		}
		if input == open_menu -> enter menu
		if board.win_conditions -> {
			apply return_hub to child_1.board
			copy child_1.board to child_checkpoint_1.board
			goto child_1
		}
	}
}

