title parabox_room_test

assets {
	css "game.css"
	script "visuals.js"
}

model puzzle parabox_room_test {
	kind = A B C

	map reverse directions {
		up -> down
		down -> up
		left -> right
		right -> left
	}

	on_level_start {
		prepare_rooms
	}

	layers {
		floor = Goal Spawn:kind Exit:kind
		room = Room:kind
		actor = Player Box Wall:kind
		marker = Moment
	}

	group {
		solid = actor
		mobile = Player Box Room:*
		lead_mobile = Player Box Room:*
		next_mobile = Player Box Room:*
		entering_mobile = Player Box Room:*
		exiting_mobile = Player Box Room:*
		inside_mobile = Player Box Room:*
		outside_mobile = Player Box Room:*
		room_food = Box Room:*
		blocked = solid Room:*
	}

	scratch {
		enter:directions
	}

	flickscreen 7 7
	screen_focus Player

	legend {
		. = empty
		# = Wall:A
		a = Wall:A
		b = Wall:B
		c = Wall:C
		P = Player
		X = Box
		G = Goal
		A = Room:A
		S = Spawn:A
		B = Room:B
		T = Spawn:B
		C = Room:C
		V = Spawn:C
		* = Goal Box
	}

	win_conditions {
		some Goal
		all Goal on Box
	}

	rules {
		prepare_rooms
		mark_mobile
		enter_room
		room_eat_mobile
		move_marked
		prepare_rooms
		mark_cross_room_push
		move_marked
		prepare_rooms
		exit_room
		move_marked
		cleanup_moment
	}

	routine mark_mobile repeat {
		once input directions [ Player no Moment ] -> [ Player Moment ]
		input directions [ lead_mobile Moment | next_mobile no Moment ] -> [ lead_mobile Moment | next_mobile Moment ]
	}

	routine mark_cross_room_push repeat {
		for d in directions {
			if input == d {
				for k in kind {
					once d [ entering_mobile Moment | Room:k{enter:d} ] [ inside_mobile Spawn:k no Moment ] -> [ entering_mobile Moment | Room:k{enter:d} ] [ inside_mobile Spawn:k Moment ]
				}
			}
			if input == reverse(d) {
				for k in kind {
					once d [ outside_mobile no Moment | Room:k{enter:d} ] [ exiting_mobile Spawn:k Moment ] -> [ outside_mobile Moment | Room:k{enter:d} ] [ exiting_mobile Spawn:k Moment ]
				}
			}
		}
	}

	routine room_eat_mobile once {
		for d in directions {
			if input == d {
				for k in kind {
					once d [ Room:k Moment | room_food Moment | blocked ] [ Spawn:k no blocked ] -> [ | Room:k Moment | blocked ] [ room_food Spawn:k ]
				}
			}
		}
	}

	routine enter_room once {
		for d in directions {
			if input == d {
				for k in kind {
					once d [ entering_mobile Moment | Room:k{enter:d} ] [ Spawn:k no blocked ] -> [ | Room:k{enter:d} ] [ entering_mobile Spawn:k ]
				}
			}
		}
	}

	routine exit_room once {
		for d in directions {
			if input == reverse(d) {
				for k in kind {
					once d [ no blocked | outside_mobile | Room:k{enter:d} ] [ exiting_mobile Spawn:k Moment ] -> [ outside_mobile | exiting_mobile | Room:k{enter:d} ] [ Spawn:k ]
					once d [ no blocked | Room:k{enter:d} ] [ exiting_mobile Spawn:k Moment ] -> [ exiting_mobile | Room:k{enter:d} ] [ Spawn:k ]
					once d [ Exit:k Wall:* | Room:k{enter:d} ] [ exiting_mobile Spawn:k Moment ] -> [ Exit:k exiting_mobile | Room:k{enter:d} ] [ Spawn:k ]
				}
			}
		}
	}

	routine move_marked repeat {
		input directions [ lead_mobile Moment | no blocked ] -> [ | lead_mobile ]
	}

	routine cleanup_moment once {
		for k in kind {
			once [ mobile Spawn:k Moment ] -> [ mobile Spawn:k ]
		}
		once [ mobile Moment ] -> [ mobile ]
	}

	routine prepare_rooms once {
		for k in kind {
			[ Exit:k ] -> [ ]
		}
		[ Room:A ] -> [ Room:A{enter:right} ]
		right [ no Exit:A | Room:A{enter:right} ] -> [ Exit:A | Room:A{enter:right} ]
		[ Room:B ] -> [ Room:B{enter:down} ]
		down [ no Exit:B | Room:B{enter:down} ] -> [ Exit:B | Room:B{enter:down} ]
		[ Room:C ] -> [ Room:C{enter:left} ]
		left [ no Exit:C | Room:C{enter:left} ] -> [ Exit:C | Room:C{enter:left} ]
	}

	level focus_rooms {
aaaaaaabbbTbbbccccccc
a...G.ab.....bc.....c
a.....ab..X..bc.....c
SP.B..ab..C..bc..A..V
a.....ab.....bc.....c
a.....ab.....bc.....c
aaaaaaabbbbbbbccccccc
	}
}

scene playing {
	view {
		board = puzzle parabox_room_test
	}
	keys {
		q -> input quit
		Escape -> input open_menu
	}
	rules {
		board.rules
		if input == open_menu -> enter menu
		if board.win_conditions -> enter complete
	}
}

scene complete {
	view {
		text "Complete"
		column {
			button "Restart" -> playing.restart
			button "Back" -> back
		}
	}
	keys {
		r -> playing.restart
		Escape Enter Space -> back
	}
}

scene menu {
	view {
		text "Menu"
		column {
			button "Resume" -> back
			button "Restart" -> playing.restart
		}
	}
	keys {
		Escape Enter Space -> input resume
		q -> input quit
	}
	rules {
		if input == resume -> back
	}
}
