@Floor
palette floor
shape floor

@Shade
palette shade
shape shade

Box:kind {
palette piece_fg:kind
shape mark:kind
}

Target:kind {
palette piece_bg:kind
shape mark:kind
}

Safe:kind
palette safe

@LightBase
palette light

@Light:kind
palette light_piece:kind

@Boundary:directions {
palette edge
shape edge:directions
}

@Corner:directions {
palette edge
shape corner:directions
}

Wall
palette wall
}
