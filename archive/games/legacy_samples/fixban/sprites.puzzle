sprites fixban of sokoban {
colors {
clear = #00000000
edge = #555
floor_a = #cfcfcf
floor_b = #c5c5c5
shade = #0002
light = #fff
wall = #444

piece_color:kind {
A = #4a4
B = #a4a
C = #46c
P = #000
}
}

palettes {
floor = floor_a floor_b
shade = shade
light = light
wall = wall
safe = clear
piece_fg:kind {
A = piece_color:A clear
B = piece_color:B clear
C = piece_color:C clear
P = piece_color:P clear
}

piece_bg:kind {
A = clear piece_color:A
B = clear piece_color:B
C = clear piece_color:C
P = clear piece_color:P
}

light_piece:kind {
A = piece_color:A
B = piece_color:B
C = piece_color:C
P = piece_color:P
}

edge = clear edge
}

