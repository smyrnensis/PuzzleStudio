title Fixban

assets {
	css "game.css"
	script "visuals.js"
}

puzzle fixban {

tags {
kind = A B C P
box_kind = A B C
}

map rotate directions {
up -> right
right -> down
down -> left
left -> up
}

layers {
floor = @Floor
shade = @Shade
target_layer = Target:kind
each Safe:kind
light = @LightBase @Light:kind
actor = Box:kind Wall
moment = Moment
each @Boundary:directions
each @Corner:directions
}

group {
target = Target:*
pushable = Box:*
solid = pushable Wall
object = Box:* Wall
wall_visual = @Boundary:* @Corner:*
}

win_conditions = count(target) == 0
lose_conditions any {
some [ Wall | ; Box:* no Box:P | Wall ]
for k in box_kind {
some [ Box:k no Safe:k ]
}
}

routine display @fill_floor repeat {
[ no @Floor ] -> [ @Floor ]
}

routine display @wall_edges repeat {
for d in directions {
d [ Wall no @Boundary:d | no Wall ] -> [ Wall @Boundary:d | ]
}
}

routine display @wall_corners_270 repeat {
for d in directions {
d [ Wall no @Corner:d | Wall ; Wall | no Wall ] -> [ Wall @Corner:d | Wall ; Wall | ]
}
}

routine mark_safe once {
repeat [ Safe:* ] -> []

for k in box_kind {
repeat [ Target:k no Safe:k ] -> [ Target:k Safe:k ]
repeat {
[ no Wall | no Wall no Safe:k | Safe:k ] -> [ | Safe:k | Safe:k ]
}
}
}

routine display @refresh_board once {
repeat [ wall_visual ] -> []
repeat [ light ] -> []
repeat [ @Shade ] -> []
repeat [ object no light ] -> [ object @LightBase ]
repeat down [ object | no @Shade ] -> [ object | @Shade ]
for k in kind {
repeat [ @LightBase Target:k ] -> [ @Light:k Target:k ]
}
@wall_edges
@wall_corners_270
}

on_level_start {
mark_safe
}

on_display {
display @fill_floor
display @refresh_board
}

rules {
once input directions [ Box:P ] -> [ Box:P Moment ]
input directions [ Box:kind Moment | pushable no Moment ] -> [ Box:kind Moment | pushable Moment ]
repeat {
input directions [ pushable Moment | no solid ] -> [ | pushable ]
}
input directions [ pushable Moment ] -> [ pushable ]

for k in kind {
[ Box:k Target:k ] -> [ Wall ]
}
}

}

import "sprites.puzzle"
import "levels.puzzle"

scene title {
	title
	subtitle
	choice "Continue" -> goto playing
	choice "New Game" -> new_game
	choice "Level Select" -> goto level_select
	on_scene_start {
		stop_music music_name
	}
	rules {
		input new_game -> {
			clear_game_progress
			goto playing("microban.1")
		}
	}
}

scene playing {
	state {
		board = puzzle fixban
	}
	view {
		row {
			title
			subtitle level.label
		}
		puzzle
	}
	inputs {
		open_menu <- Escape
		level_select <- q
	}
	rules {
		step board
		open_menu -> enter menu
		level_select -> {
			goto level_select
		}
	}
}

scene menu {
	view {
		text "Menu"
		column {
			choice "Resume" -> input resume
			choice "Restart" -> playing.restart
			choice "Level Select" -> goto level_select
		}
	}
	inputs {
		resume <- Escape Enter Space
		level_select <- q
	}
	rules {
		resume -> {
			back
		}
		level_select -> {
			goto level_select
		}
	}
}

	scene level_select {
			view {
				text "Select a level"
				level_menu microban -> goto playing(level)
				button "Back" -> goto title
			}
		inputs {
			back_to_title <- q Escape
		}
	rules {
		back_to_title -> goto title
	}
}



