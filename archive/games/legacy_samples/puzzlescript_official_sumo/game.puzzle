title "Multiple Patterns"
author increpare
homepage "www.puzzlescript.net"

theme puzzlescript

model puzzle main {
layers {
  layer_1 = Background
  layer_2 = Player Wall Sumo
}

sprites {
  Background
    #90ee90 #008000
    11111
    01111
    11101
    11111
    10111

  Wall
    #a46322 #493c2b
    00010
    11111
    01000
    11111
    00010

  Player
    #000000 #ffa500 #ffffff #0000ff
    .000.
    .111.
    22222
    .333.
    .3.3.

  Sumo
    #ffc0cb #ffffff
    ..0..
    00000
    .000.
    .111.
    .0.0.
}

legend {
  . = Background
  # = Wall
  P = Player
  S = Sumo
  _ = empty
}

on_level_start {
  once_all [ no Background ] -> [ Background ]
}

rules {
  input directions [ Player ] -> [ Player{>} ]
  [ Player{>} ] [ Sumo ] -> [ Player{>} ] [ Sumo{>} ]
  move
}

levels {
  ########
  #......#
  #......#
  #.P..S.#
  #......#
  #......#
  ########
}
}

scene title {
  title "Multiple Patterns"
  subtitle "by increpare"
  button "Play" -> start levels in playing
  keys {
    Enter Space x -> start levels in playing
  }
}

scene playing {
  state {
    board = puzzle main
  }
  view {
    row {
      title "Multiple Patterns"
    }
    puzzle board
  }
  keys {
    w ArrowUp -> input up
    s ArrowDown -> input down
    a ArrowLeft -> input left
    d ArrowRight -> input right
    r -> board.restart
    Escape -> goto title
  }
  rules {
    board.rules
  }
}
