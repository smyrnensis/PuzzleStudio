}

scene title {
  title "Simple Block Sliding Game"
  subtitle "by increpare"
  button "Play" -> start levels in playing
  keys {
    Enter Space x -> start levels in playing
  }
}

scene playing {
  state {
    board = puzzle main
  }
  view {
    row {
      title "Simple Block Sliding Game"
    }
    puzzle board
  }
  keys {
    w ArrowUp -> input up
    s ArrowDown -> input down
    a ArrowLeft -> input left
    d ArrowRight -> input right
    r -> board.restart
    Escape -> goto title
  }
  rules {
    board.rules
    if board.win_conditions -> {
      board.next_level
    }
  }
}
