#.AB..#
#.#.P.#
#.ab.##
#######
}

level_4 {
#########
###..####
###A.####
##.bBa.##
##.P...##
###..####
#########
}

level_5 {
#######
###..##
#Pb..##
#.#BBb#
#..aA.#
#....##
#######
}

level_6 {
########
#......#
#.2..1.#
#.#.P#.#
#.#2.1.#
#......#
########
}

level_7 {
