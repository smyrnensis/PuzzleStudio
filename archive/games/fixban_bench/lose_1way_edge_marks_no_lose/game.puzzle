name Fixban

puzzle fixban {
kind = A B C P
box_kind = A B C
shade_kind = base

map rotate directions {
up -> right
right -> down
down -> left
left -> up
}

level_start {
mark_edges
mark_edge_deadlocks
refresh_board
}

objects {
Target:kind
Box:kind Wall Moment
Edge:directions EdgeLeft:directions EdgeRight:directions Safe:kind:directions Dead:kind:directions
target = Target
pushable = Box
solid = pushable Wall
object = Box Wall
}

display_objects {
Shade:shade_kind
LightBase Light:kind
Boundary:directions
Corner:directions
light = LightBase Light:kind
shade = Shade:shade_kind
wall_visual = Boundary Corner
}

layers {
target_layer = Target:kind
each Edge:directions
each EdgeLeft:directions
each EdgeRight:directions
each Safe:kind:directions
each Dead:kind:directions
Shade:shade_kind
LightBase Light:kind
actor = Box:kind Wall
moment = Moment
each Boundary:directions
each Corner:directions
}

legend {
. = empty
a = Target:A
b = Target:B
c = Target:C
p = Target:P
A = Box:A
B = Box:B
C = Box:C
P = Box:P
# = Wall
1 = Box:A Target:B
2 = Box:B Target:A
}

win_conditions = count(target) == 0
lose_conditions any {
exists([ Wall | ; Box no Box:P | Wall ])
}

sprites {
shape mark:kind {
A {
00000
01010
00100
01010
00000
}
B {
00000
00100
01010
00100
00000
}
C {
00000
00100
00100
00100
00000
}
P {
00000
00000
01010
00000
00000
}
}

shape edge:directions rotate from up {
11111
00000
00000
00000
00000
}

shape corner:directions rotate from up {
00001
00000
00000
00000
00000
}

shape fill:kind {
A {
00000
00000
00000
00000
00000
}
B {
00000
00000
00000
00000
00000
}
C {
00000
00000
00000
00000
00000
}
P {
00000
00000
00000
00000
00000
}
}

shape shade_fill:shade_kind {
base {
00000
00000
00000
.....
.....
}
}

colors piece_color:kind {
A = #4a4
B = #a4a
C = #46c
P = #000
}

Box:kind = ascii mark:kind {
0 = piece_color:kind
1 = transparent
}

Target:kind = ascii mark:kind {
0 = transparent
1 = piece_color:kind
}

Boundary:directions = ascii edge:directions {
0 = transparent
1 = #555
}

Corner:directions = ascii corner:directions {
0 = transparent
1 = #555
}

Shade:shade_kind = ascii shade_fill:shade_kind {
0 = #0002
. = transparent
}

LightBase = solid #fff
Light:kind = ascii fill:kind {
0 = piece_color:kind
}
Wall = solid #444
}

rule display wall_edges repeat {
for d in directions {
d [ Wall no Boundary:d | no Wall ] -> [ Wall Boundary:d | ]
}
}

rule display wall_corners_270 repeat {
for d in directions {
d [ Wall no Corner:d | Wall ; Wall | no Wall ] -> [ Wall Corner:d | Wall ; Wall | ]
}
}

rule mark_edges once {
repeat [ Edge ] -> []
repeat [ EdgeLeft ] -> []
repeat [ EdgeRight ] -> []
repeat up [ Wall | no Wall no EdgeLeft:up ; Wall | Wall ] -> [ Wall | EdgeLeft:up ; Wall | Wall ]
repeat up [ no Wall no EdgeRight:up | Wall ; Wall | Wall ] -> [ EdgeRight:up | Wall ; Wall | Wall ]
repeat up [ EdgeLeft:up no Wall | no Wall no EdgeLeft:up ; Wall | Wall ] -> [ EdgeLeft:up | EdgeLeft:up ; Wall | Wall ]
repeat up [ no Wall no EdgeRight:up | EdgeRight:up no Wall ; Wall | Wall ] -> [ EdgeRight:up | EdgeRight:up ; Wall | Wall ]
repeat [ EdgeLeft:up EdgeRight:up no Edge:up ] -> [ EdgeLeft:up EdgeRight:up Edge:up ]

repeat down [ Wall | no Wall no EdgeLeft:down ; Wall | Wall ] -> [ Wall | EdgeLeft:down ; Wall | Wall ]
repeat down [ no Wall no EdgeRight:down | Wall ; Wall | Wall ] -> [ EdgeRight:down | Wall ; Wall | Wall ]
repeat down [ EdgeLeft:down no Wall | no Wall no EdgeLeft:down ; Wall | Wall ] -> [ EdgeLeft:down | EdgeLeft:down ; Wall | Wall ]
repeat down [ no Wall no EdgeRight:down | EdgeRight:down no Wall ; Wall | Wall ] -> [ EdgeRight:down | EdgeRight:down ; Wall | Wall ]
repeat [ EdgeLeft:down EdgeRight:down no Edge:down ] -> [ EdgeLeft:down EdgeRight:down Edge:down ]

repeat left [ Wall | no Wall no EdgeLeft:left ; Wall | Wall ] -> [ Wall | EdgeLeft:left ; Wall | Wall ]
repeat left [ no Wall no EdgeRight:left | Wall ; Wall | Wall ] -> [ EdgeRight:left | Wall ; Wall | Wall ]
repeat left [ EdgeLeft:left no Wall | no Wall no EdgeLeft:left ; Wall | Wall ] -> [ EdgeLeft:left | EdgeLeft:left ; Wall | Wall ]
repeat left [ no Wall no EdgeRight:left | EdgeRight:left no Wall ; Wall | Wall ] -> [ EdgeRight:left | EdgeRight:left ; Wall | Wall ]
repeat [ EdgeLeft:left EdgeRight:left no Edge:left ] -> [ EdgeLeft:left EdgeRight:left Edge:left ]

repeat right [ Wall | no Wall no EdgeLeft:right ; Wall | Wall ] -> [ Wall | EdgeLeft:right ; Wall | Wall ]
repeat right [ no Wall no EdgeRight:right | Wall ; Wall | Wall ] -> [ EdgeRight:right | Wall ; Wall | Wall ]
repeat right [ EdgeLeft:right no Wall | no Wall no EdgeLeft:right ; Wall | Wall ] -> [ EdgeLeft:right | EdgeLeft:right ; Wall | Wall ]
repeat right [ no Wall no EdgeRight:right | EdgeRight:right no Wall ; Wall | Wall ] -> [ EdgeRight:right | EdgeRight:right ; Wall | Wall ]
repeat [ EdgeLeft:right EdgeRight:right no Edge:right ] -> [ EdgeLeft:right EdgeRight:right Edge:right ]
}

rule mark_edge_deadlocks once {
repeat [ Safe ] -> []
repeat [ Dead ] -> []

for k in box_kind {
for d in directions {
[ Target:k Edge:d no Safe:k:d ] -> [ Target:k Edge:d Safe:k:d ]
}
}

for k in box_kind {
repeat up [ Safe:k:up no Wall | Edge:up no Wall no Safe:k:up ; Wall | Wall ] -> [ Safe:k:up | Edge:up Safe:k:up ; Wall | Wall ]
repeat up [ Edge:up no Wall no Safe:k:up | Safe:k:up no Wall ; Wall | Wall ] -> [ Edge:up Safe:k:up | Safe:k:up ; Wall | Wall ]

repeat down [ Safe:k:down no Wall | Edge:down no Wall no Safe:k:down ; Wall | Wall ] -> [ Safe:k:down | Edge:down Safe:k:down ; Wall | Wall ]
repeat down [ Edge:down no Wall no Safe:k:down | Safe:k:down no Wall ; Wall | Wall ] -> [ Edge:down Safe:k:down | Safe:k:down ; Wall | Wall ]

repeat left [ Safe:k:left no Wall | Edge:left no Wall no Safe:k:left ; Wall | Wall ] -> [ Safe:k:left | Edge:left Safe:k:left ; Wall | Wall ]
repeat left [ Edge:left no Wall no Safe:k:left | Safe:k:left no Wall ; Wall | Wall ] -> [ Edge:left Safe:k:left | Safe:k:left ; Wall | Wall ]

repeat right [ Safe:k:right no Wall | Edge:right no Wall no Safe:k:right ; Wall | Wall ] -> [ Safe:k:right | Edge:right Safe:k:right ; Wall | Wall ]
repeat right [ Edge:right no Wall no Safe:k:right | Safe:k:right no Wall ; Wall | Wall ] -> [ Edge:right Safe:k:right | Safe:k:right ; Wall | Wall ]
}

for k in box_kind {
for d in directions {
[ Edge:d no Safe:k:d no Dead:k:d ] -> [ Edge:d Dead:k:d ]
}
}
}

rule display refresh_board once {
repeat [ wall_visual ] -> []
wall_edges
wall_corners_270

repeat [ light ] -> []
repeat [ shade ] -> []
repeat [ object no light ] -> [ object LightBase ]
repeat down [ object | no solid no shade ] -> [ object | shade ]
for k in kind {
repeat [ LightBase Target:k ] -> [ Light:k Target:k ]
}
}

main {
once input [ Box:P ] -> [ Box:P Moment ]
input [ Box:kind Moment | pushable no Moment ] -> [ Box:kind Moment | pushable Moment ]
repeat {
input [ pushable Moment | no solid ] -> [ | pushable ]
}
input [ pushable Moment ] -> [ pushable ]

for k in kind {
[ Box:k Target:k ] -> [ Wall ]
}
display refresh_board
}

levels {
level_1 {
########
##.a####
##A.####
##a...##
##..A.##
##P.####
########
}

level_2 {
