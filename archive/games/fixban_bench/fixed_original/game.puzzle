name Fixban

puzzle fixban {
kind = A B C P
shade_kind = base

map rotate directions {
up -> right
right -> down
down -> left
left -> up
}

level_start {
display refresh_board
}

objects {
Target:kind
Box:kind Wall Moment
target = Target
pushable = Box
solid = pushable Wall
object = Box Wall
}

display_objects {
Shade:shade_kind
LightBase Light:kind
Fixed
Boundary:directions
Corner:directions
light = LightBase Light:kind
shade = Shade:shade_kind
wall_visual = Boundary Corner
}

layers {
target_layer = Target:kind
Shade:shade_kind
LightBase Light:kind
actor = Box:kind Wall
moment = Moment
fixed = Fixed
each Boundary:directions
each Corner:directions
}

legend {
. = empty
a = Target:A
b = Target:B
c = Target:C
p = Target:P
A = Box:A
B = Box:B
C = Box:C
P = Box:P
# = Wall
1 = Box:A Target:B
2 = Box:B Target:A
}

win_conditions {
all Target:A on Box:A
all Target:B on Box:B
all Target:C on Box:C
all Target:P on Box:P
}

sprites {
shape mark:kind {
A {
00000
01010
00100
01010
00000
}
B {
00000
00100
01010
00100
00000
}
C {
00000
00100
00100
00100
00000
}
P {
00000
00000
01010
00000
00000
}
}

shape edge:directions rotate from up {
11111
00000
00000
00000
00000
}

shape corner:directions rotate from up {
00001
00000
00000
00000
00000
}

shape fill:kind {
A {
00000
00000
00000
00000
00000
}
B {
00000
00000
00000
00000
00000
}
C {
00000
00000
00000
00000
00000
}
P {
00000
00000
00000
00000
00000
}
}

shape shade_fill:shade_kind {
base {
00000
00000
00000
.....
.....
}
}

colors piece_color:kind {
A = #4a4
B = #a4a
C = #46c
P = #000
}

Box:kind = ascii mark:kind {
0 = piece_color:kind
1 = transparent
}

Target:kind = ascii mark:kind {
0 = transparent
1 = piece_color:kind
}

Boundary:directions = ascii edge:directions {
0 = transparent
1 = #555
}

Corner:directions = ascii corner:directions {
0 = transparent
1 = #555
}

Shade:shade_kind = ascii shade_fill:shade_kind {
0 = #0002
. = transparent
}

LightBase = solid #fff
Light:kind = ascii fill:kind {
0 = piece_color:kind
}
Fixed = solid #444
Wall = solid #444
}

rule display wall_edges repeat {
for d in directions {
d [ Wall no Boundary:d | no Wall ] -> [ Wall Boundary:d | ]
}
}

rule display wall_corners_270 repeat {
for d in directions {
d [ Wall no Corner:d | Wall ; Wall | no Wall ] -> [ Wall Corner:d | Wall ; Wall | ]
}
}

rule display refresh_board once {
repeat [ wall_visual ] -> []
repeat [ Fixed ] -> []
for k in kind {
repeat [ Box:k Target:k no Fixed ] -> [ Box:k Target:k Fixed ]
}
wall_edges
wall_corners_270

repeat [ light ] -> []
repeat [ shade ] -> []
repeat [ object no light ] -> [ object LightBase ]
repeat down [ object | no solid no shade ] -> [ object | shade ]
for k in kind {
repeat [ LightBase Target:k ] -> [ Light:k Target:k ]
}
}

main {
once input [ Box:P no Target:P ] -> [ Box:P Moment ]
repeat {
for k in kind {
input [ Box:kind Moment | Box:k no Target:k no Moment ] -> [ Box:kind Moment | Box:k Moment ]
}
}
repeat {
for k in kind {
input [ Box:k Moment no Target:k | no solid ] -> [ | Box:k ]
}
}
input [ pushable Moment ] -> [ pushable ]
display refresh_board
}

levels {
level_1 {
########
##.a####
##A.####
##a...##
##..A.##
##P.####
########
}

level_2 {
########
#...####
#P.AA..#
###Aa..#
##.....#
##a.a.##
########
}

level_3 {
#######
###..##
#.AB..#
#.#.P.#
#.ab.##
#######
}

level_4 {
#########
###..####
###A.####
##.bBa.##
##.P...##
###..####
#########
}

level_5 {
#######
###..##
#Pb..##
#.#BBb#
#..aA.#
#....##
#######
}

level_6 {
########
#......#
#.2..1.#
#.#.P#.#
#.#2.1.#
#......#
########
}

level_7 {
########
