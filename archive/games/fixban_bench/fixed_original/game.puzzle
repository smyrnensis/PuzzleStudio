#.B.Bb.#
##.Aa..#
###.b.P#
########
}

level_8 {
########
####...#
#PA.b2.#
#.1p.B.#
#...a..#
########
}
}
}

scene playing {
layers {
row {
title game.title
subtitle join level.number, ". ", level.label
}
board = puzzle fixban
}
keys {
q = quit
Escape = open_menu
}
transitions {
board.main
quit -> goto level_select
open_menu -> enter menu
if board.win_conditions and level.last -> goto level_select
if board.win_conditions -> board.next_level
}
}

scene level_clear {
layers {
board = puzzle fixban current_level
message = "Stage clear"
panel {
text message
button "Next Level" -> goto playing with level = next(level)
button "Restart" -> restart
button "Level Select" -> goto level_select
}
}
keys {
Enter Space = next_level
q = quit
}
transitions {
next_level -> board.next_level
quit -> goto level_select
}
}

scene menu {
layers {
text "Menu"
column {
button "Resume" -> back
button "Restart" -> restart
button "Level Select" -> goto level_select
}
}
keys {
Escape Enter Space = resume
q = quit
}
transitions {
resume -> back
quit -> goto level_select
}
}

scene level_select {
layers {
message = "Select a stage"
text message
level_menu {
show index
show cleared
button "Back" -> back
}
}
keys {
w ArrowUp = menu_up
s ArrowDown = menu_down
Enter Space = confirm
Escape q = back
}
}
