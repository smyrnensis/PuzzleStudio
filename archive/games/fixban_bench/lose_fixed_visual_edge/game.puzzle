00000
00100
01010
00100
00000
}
C {
00000
00100
00100
00100
00000
}
P {
00000
00000
01010
00000
00000
}
}

shape edge:directions rotate from up {
11111
00000
00000
00000
00000
}

shape corner:directions rotate from up {
00001
00000
00000
00000
00000
}

shape fill:kind {
A {
00000
00000
00000
00000
00000
}
B {
00000
00000
00000
00000
00000
}
C {
00000
00000
00000
00000
00000
}
P {
00000
00000
00000
00000
00000
}
}

shape shade_fill:shade_kind {
base {
00000
00000
00000
.....
.....
}
}

colors piece_color:kind {
A = #4a4
B = #a4a
C = #46c
P = #000
}

Box:kind = ascii mark:kind {
0 = piece_color:kind
1 = transparent
}

Target:kind = ascii mark:kind {
0 = transparent
1 = piece_color:kind
}

Boundary:directions = ascii edge:directions {
0 = transparent
1 = #555
}

Corner:directions = ascii corner:directions {
0 = transparent
1 = #555
}

Shade:shade_kind = ascii shade_fill:shade_kind {
0 = #0002
. = transparent
}

LightBase = solid #fff
Light:kind = ascii fill:kind {
0 = piece_color:kind
}
Wall = solid #444
}

rule display wall_edges repeat {
for d in directions {
d [ Wall no Boundary:d | no Wall ] -> [ Wall Boundary:d | ]
}
}

rule display wall_corners_270 repeat {
for d in directions {
d [ Wall no Corner:d | Wall ; Wall | no Wall ] -> [ Wall Corner:d | Wall ; Wall | ]
}
}

rule fix_board repeat {
for k in kind {
repeat [ Box:k Target:k no Wall ] -> [ Box:k Target:k Wall ]
}
}

rule mark_edges once {
repeat [ Edge ] -> []
repeat [ EdgeLeft ] -> []
repeat [ EdgeRight ] -> []
for d in directions {
repeat d [ Wall | no Wall no EdgeLeft:rotate(d) ; Wall | Wall ] -> [ Wall | EdgeLeft:rotate(d) ; Wall | Wall ]
repeat d [ no Wall no EdgeRight:rotate(d) | Wall ; Wall | Wall ] -> [ EdgeRight:rotate(d) | Wall ; Wall | Wall ]
repeat d [ EdgeLeft:rotate(d) no Wall | no Wall no EdgeLeft:rotate(d) ; Wall | Wall ] -> [ EdgeLeft:rotate(d) | EdgeLeft:rotate(d) ; Wall | Wall ]
repeat d [ no Wall no EdgeRight:rotate(d) | EdgeRight:rotate(d) no Wall ; Wall | Wall ] -> [ EdgeRight:rotate(d) | EdgeRight:rotate(d) ; Wall | Wall ]
repeat [ EdgeLeft:rotate(d) EdgeRight:rotate(d) no Edge:rotate(d) ] -> [ EdgeLeft:rotate(d) EdgeRight:rotate(d) Edge:rotate(d) ]
}
}

rule mark_edge_deadlocks once {
repeat [ Probe ] -> []
repeat [ Found ] -> []

for k in box_kind {
for d in directions {
[ Box:k Edge:d no Probe:k:d ] -> [ Box:k Edge:d Probe:k:d ]
}
}

for k in box_kind {
for d in directions {
repeat d [ Probe:k:rotate(d) no Wall | no Wall no Probe:k:rotate(d) ; Wall | Wall ] -> [ Probe:k:rotate(d) | Probe:k:rotate(d) ; Wall | Wall ]
repeat d [ no Wall no Probe:k:rotate(d) | Probe:k:rotate(d) no Wall ; Wall | Wall ] -> [ Probe:k:rotate(d) | Probe:k:rotate(d) ; Wall | Wall ]
}
}

for k in box_kind {
for d in directions {
[ Probe:k:d Target:k no Found:k:d ] -> [ Probe:k:d Target:k Found:k:d ]
}
}

for k in box_kind {
for d in directions {
repeat d [ Found:k:rotate(d) no Wall | Probe:k:rotate(d) no Wall no Found:k:rotate(d) ; Wall | Wall ] -> [ Found:k:rotate(d) | Probe:k:rotate(d) Found:k:rotate(d) ; Wall | Wall ]
repeat d [ Probe:k:rotate(d) no Wall no Found:k:rotate(d) | Found:k:rotate(d) no Wall ; Wall | Wall ] -> [ Probe:k:rotate(d) Found:k:rotate(d) | Found:k:rotate(d) ; Wall | Wall ]
}
}
}

rule display refresh_board once {
repeat [ wall_visual ] -> []
wall_edges
wall_corners_270

repeat [ light ] -> []
repeat [ shade ] -> []
repeat [ object no light ] -> [ object LightBase ]
repeat down [ object | no solid no shade ] -> [ object | shade ]
for k in kind {
repeat [ LightBase Target:k ] -> [ Light:k Target:k ]
}
}

main {
once input [ Box:P no Target:P ] -> [ Box:P Moment ]
repeat {
for k in kind {
input [ Box:kind Moment | Box:k no Target:k no Moment ] -> [ Box:kind Moment | Box:k Moment ]
}
}
repeat {
for k in kind {
input [ Box:k Moment no Target:k | no solid ] -> [ | Box:k ]
}
}
input [ pushable Moment ] -> [ pushable ]
fix_board
mark_edge_deadlocks
display refresh_board
}

