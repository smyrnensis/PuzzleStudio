name Fixban

puzzle fixban {
kind = A B C P
box_kind = A B C
shade_kind = base

map rotate directions {
up -> right
right -> down
down -> left
left -> up
}

level_start {
fix_board
mark_edges
mark_edge_deadlocks
refresh_board
}

objects {
Target:kind
Box:kind Wall Moment
Edge:directions EdgeLeft:directions EdgeRight:directions Probe:kind:directions Found:kind:directions
target = Target
pushable = Box
solid = pushable Wall
object = Box Wall
}

display_objects {
Shade:shade_kind
LightBase Light:kind
Boundary:directions
Corner:directions
light = LightBase Light:kind
shade = Shade:shade_kind
wall_visual = Boundary Corner
}

layers {
target_layer = Target:kind
each Edge:directions
each EdgeLeft:directions
each EdgeRight:directions
each Probe:kind:directions
each Found:kind:directions
Shade:shade_kind
LightBase Light:kind
actor = Box:kind
wall = Wall
moment = Moment
each Boundary:directions
each Corner:directions
}

legend {
. = empty
a = Target:A
b = Target:B
c = Target:C
p = Target:P
A = Box:A
B = Box:B
C = Box:C
P = Box:P
# = Wall
1 = Box:A Target:B
2 = Box:B Target:A
}

win_conditions {
for k in kind {
all Target:k on Box:k
}
}
lose_conditions any {
for k in box_kind {
exists([ Wall | ; Box:k no Target:k | Wall ])
}
for k in box_kind {
for d in directions {
exists([ Box:k Edge:d no Found:k:d ])
}
}
}

