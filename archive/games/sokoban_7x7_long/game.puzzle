name sokoban_7x7_pushy

puzzle sokoban_7x7_long {

objects {
layers {
floor = Goal
actor = Player Box Wall
}

groups {
solid = actor
}
}

legend {
. = empty
G = Goal
P = Player
B = Box
# = Wall
* = Goal Box
+ = Goal Player
}

win_conditions {
some Goal
all Goal on Box
}

main {
once input [ Player | Box | no solid ] -> [ | Player | Box ]
once input [ Player | no solid ] -> [ | Player ]
}





level interference_16 {
#######
###.PG#
###.#B#
#..B.G#
#.GB..#
###...#
#######
}

level relay_16 {
#######
#G..###
#.G.B.#
##.BG.#
###B.P#
###...#
#######
}

level balanced_14_4box {
#######
##G#.G#
#.B.B.#
#.G#.G#
#.B.B.#
##P...#
#######
}

level switchforced_14_a {
#######
####..#
#.....#
#...B.#
#BG#B##
#G.GP##
#######
}
}
scene playing {
view {
board = puzzle sokoban_7x7_long
}
keys {
q = quit
Escape = open_menu
}
transitions {
board.main
quit -> goto level_select
open_menu -> enter menu
if board.win_conditions -> board.next_level
}
}

scene level_clear {
view {
board = puzzle sokoban_7x7_long current_level
message = "Stage clear"
panel {
text message
button "Next Level" -> playing.next_level
button "Restart" -> playing.restart
button "Level Select" -> goto level_select
}
}
keys {
Enter Space = playing.next_level
q = quit
}
transitions {
quit -> goto level_select
}
}

scene menu {
view {
text "Menu"
column {
button "Resume" -> back
button "Restart" -> playing.restart
button "Level Select" -> goto level_select
}
}
keys {
Escape Enter Space = resume
q = quit
}
transitions {
resume -> back
quit -> goto level_select
}
}

scene level_select {
view {
message = "Select a stage"
text message
level_menu {
index on
button "Back" -> back
}
}
}
