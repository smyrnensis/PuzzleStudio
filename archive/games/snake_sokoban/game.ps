left  [ BodyRight Moved | TailRight ] -> [ TailRight | ]

down  [ Moved | BodyUp ] -> [ | BodyUp Moved ]
up    [ Moved | BodyDown ] -> [ | BodyDown Moved ]
right [ Moved | BodyLeft ] -> [ | BodyLeft Moved ]
left  [ Moved | BodyRight ] -> [ | BodyRight Moved ]

endloop

up    [ TailUp | BodyUp | HeadUp ] -> cancel
down  [ TailDown | BodyDown | HeadDown ] -> cancel
left  [ TailLeft | BodyLeft | HeadLeft ] -> cancel
right [ TailRight | BodyRight | HeadRight ] -> cancel

