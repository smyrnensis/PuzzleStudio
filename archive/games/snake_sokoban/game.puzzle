name Snake Sokoban

model puzzle snake_sokoban {
parity = a b
tile = base

map flip parity {
a -> b
b -> a
}

map rotate directions {
up -> right
right -> down
down -> left
left -> up
}

objects {
Goal:tile
Head:directions Body:directions Tail:parity:directions Box:tile Wall:tile
Moved
}

layers {
floor = Goal:tile
actor = Head:directions Body:directions Tail:parity:directions Box:tile Wall:tile
marker = Moved
}

group {
snake = Head Body Tail
pushable = Box
solid = actor
}

global moved = false

scratch {
stepped
straight
}

legend {
. = empty
# = Wall
G = Goal
B = Box
* = Goal Box
> = Head:right
< = Head:left
^ = Head:up
V = Head:down
r = Body:right
l = Body:left
u = Body:up
d = Body:down
R = Tail:a:right
L = Tail:a:left
U = Tail:a:up
T = Tail:a:down
}

render_overlay Goal Box *

win_conditions {
some Goal
all Goal on Box
}

import "sprites.puzzle"

routine reset_turn once {
once [ Head ] -> set moved = false
}

routine move_head once {
for d in directions {
if input == d {
once d [ Head no Moved | Box{no >} ] -> [ Head Moved | > Box ]
repeat d [ > pushable | pushable{no >} ] -> [ > pushable | > pushable ]
move
once d [ Head Moved | no solid ] -> [ Body:d | Head:d Moved ] set moved = true
once d [ Head no Moved | no solid ] -> [ Body:d | Head:d Moved ] set moved = true
}
}
}

routine advance_tail once {
for p in parity {
for tail_dir in directions {
for scan in directions {
for next in directions {
once scan [ Tail:p:tail_dir{no stepped} | Body:next ] -> [ | Tail:flip(p):next{stepped} ]
}
}
}
}
}

routine reject_fully_straight once {
for p in parity {
for tail_dir in directions {
for scan in directions {
once [ Tail:p:tail_dir ] -> [ Tail:p:tail_dir{straight} ]
repeat scan [ Tail:p:tail_dir{straight} | Body{no straight} ] -> [ Tail:p:tail_dir{straight} | Body{straight} ]
repeat scan [ Body{straight} | Body{no straight} ] -> [ Body{straight} | Body{straight} ]
if none([ Body{no straight} ]) {
once scan [ Body{straight} | Head ] -> cancel
once scan [ Tail:p:tail_dir{straight} | Head ] -> cancel
}
repeat [ Tail{straight} ] -> [ Tail ]
repeat [ Body{straight} ] -> [ Body ]
}
}
}
}

routine cleanup once {
repeat [ Moved ] -> []
for d in directions {
repeat d [ d Box ] -> [ Box ]
}
repeat [ Tail{stepped} ] -> [ Tail ]
repeat [ Tail{straight} ] -> [ Tail ]
repeat [ Body{straight} ] -> [ Body ]
}

rules {
reset_turn
move_head
if moved == true {
advance_tail
reject_fully_straight
}
cleanup
}

import "levels.puzzle"
}

scene playing {
view {
row {
title "Snake Sokoban"
subtitle board.level.label
}
board = puzzle snake_sokoban
}
keys {
q = quit
Escape = open_menu
}
rules {
board.rules
quit -> goto level_select
open_menu -> enter menu
if board.win_conditions and board.level.last -> goto level_select
if board.win_conditions -> board.next_level
}
}

scene level_clear {
view {
board = puzzle snake_sokoban
message = "Level clear"
panel {
text message
button "Next Level" -> playing.next_level
button "Restart" -> playing.restart
button "Level Select" -> goto level_select
}
}
keys {
Enter Space -> playing.next_level
q = quit
}
rules {
quit -> goto level_select
}
}

scene menu using menu {
view {
text "Menu"
column {
button "Resume" -> back
button "Restart" -> playing.restart
button "Level Select" -> goto level_select
}
}
keys {
Escape Enter Space = resume
q = quit
}
rules {
resume -> back
quit -> goto level_select
}
}

scene level_select {
view {
message = "Select a level"
text message
level_menu {
show_index = true
button "Back" -> back
}
}
}
