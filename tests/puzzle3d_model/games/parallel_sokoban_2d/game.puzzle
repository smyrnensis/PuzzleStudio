title "Parallel Sokoban 2D"

puzzle sokoban_2d {
  layers {
    floor = @Floor
    target = Goal
    solid = Player Box Wall
  }

  sprites {
    @Floor {
      #90ee90 #008000
      11111
      01111
      11101
      11111
      10111
    }

    Wall {
      #a46322 #493c2b
      00010
      11111
      01000
      11111
      00010
    }

    Goal {
      #00008b
      .....
      .000.
      .0.0.
      .000.
      .....
    }

    Box {
      #ffa500 #ffff00
      00000
      0...0
      0...0
      0...0
      00000
    }

    Player {
      #000000 #ffa500 #ffffff #0000ff
      .000.
      .111.
      22222
      .333.
      .3.3.
    }
  }

  legend {
    . = empty
    G = Goal
    P = Player
    B = Box
    # = Wall
    * = Goal Box
    + = Goal Player
  }

  win_conditions {
    some Goal
    all Goal on Box
  }

  rules {
    once input directions [ Player | Box | no solid ] -> [ | Player | Box ]
    once input directions [ Player | no solid ] -> [ | Player ]
  }

  on_level_start {
    display [ no @Floor ] -> [ @Floor ]
  }

  levels {
    level microban_01
    ####..
    #.G#..
    #..###
    #*P..#
    #..B.#
    #..###
    ####..

    level microban_02
    ######
    #....#
    #.#P.#
    #.B*.#
    #.G*.#
    #....#
    ######

    level microban_03
    ..####...
    ###..####
    #.....B.#
    #.#..#B.#
    #.G.G#P.#
    #########
  }
}

scene playing {
  state {
    board = puzzle sokoban_2d
  }

  view {
    puzzle board
  }

  rules {
    board.rules
    if board.win_conditions -> board.next_level
  }
}
