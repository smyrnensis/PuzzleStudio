title = "Microban Basic 3D"

puzzle3 sokoban_literally_in_3d {
  render {
    camera {
      yaw 15
      pitch 55
      zoom 1.1
      interactive_look false
      interactive_zoom false
    }
    grid {
      occupied_cells true
    }
  }

  layers {
    floor = Floor
    target = Goal
    solid = Player Box Wall
  }

  group solid = Player Box Wall

  rules {
    input horizontal [ Player | Box | no solid ] -> [ | Player | Box ]
    input horizontal [ Player | no solid ] -> [ | Player ]
  }

  win_conditions {
    some Goal
    no down [ no Box | Goal ]
  }

  on_level_clear {
    if win_conditions -> next_level
  }
}

scene title {
  layout {
    title "Microban Basic 3D"
    button "Start" -> goto playing
    button "Level Select" -> goto level_select
  }
}

scene level_select {
  layout {
    title "Select Level"
    level_menu
    button "Back" -> goto title
  }
}

scene playing {
  keys {
    q Escape -> goto level_select
  }

  rules {
    step board
  }

  layout {
    box size 8 8 {
      board = puzzle3 sokoban_literally_in_3d size 7 7
    }
  }
}

levels3 microban of sokoban_literally_in_3d {
  legend {
    . = empty
    , = Floor
    G = Floor Goal
    P = Player
    B = Box
    # = Wall
  }

  level "microban_01" {
    ####..
    #..#..
    #..###
    #BP..#
    #..B.#
    #..###
    ####..

    ,,,,,,
    ,,G,,,
    ,,,,,,
    ,G,,,,
    ,,,,,,
    ,,,,,,
    ,,,,,,
  }

  level "microban_02" {
    ######
    #....#
    #.#P.#
    #.BB.#
    #..B.#
    #....#
    ######

    ,,,,,,
    ,,,,,,
    ,,,,,,
    ,,,G,,
    ,,GG,,
    ,,,,,,
    ,,,,,,
  }

  level "microban_03" {
    ..####...
    ###..####
    #.....B.#
    #.#..#B.#
    #....#P.#
    #########

    ,,,,,,,,,
    ,,,,,,,,,
    ,,,,,,,,,
    ,,,,,,,,,
    ,,G,G,,,,
    ,,,,,,,,,
  }
}

