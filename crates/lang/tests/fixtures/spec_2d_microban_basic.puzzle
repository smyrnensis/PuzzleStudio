const title = "Microban"
const author = "Levels by David Skinner"

theme = puzzlescript

puzzle sokoban {
layers {
Background
Goal
solid = Player Box Wall
}

win_conditions {
some Goal
no [ Box no Goal ]
}

on_level_start {
once_all [ no Background ] -> [ Background ]
}

rules {
input [ Player ] -> [ > Player ]
[ > Player | Box ] -> [ > Player | > Box ]
[ > solid | no solid ] -> [ | solid ]
[ > solid ] -> [ solid ]
}

on_level_clear {
wait 0.30s
next_level
}
}

visuals {
Background
#90ee90 #008000
11111
01111
11101
11111
10111

Wall
#a46322 #493c2b
00010
11111
01000
11111
00010

Goal
