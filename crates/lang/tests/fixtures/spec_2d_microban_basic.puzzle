.....
.000.
.0.0.
.000.
.....

Box
#ffa500 #ffff00
00000
0...0
0...0
0...0
00000

Player
#000000 #ffa500 #ffffff #0000ff
.000.
.111.
22222
.333.
.3.3.
}

levels microban of sokoban {
legend {
. = empty
G = Goal
P = Player
B = Box
# = Wall
* = Goal Box
+ = Goal Player
}

