#########..
}

scene title {
layout {
heading "Microban"
subheading "Levels by David Skinner"
choice "Continue" -> goto playing
choice "New Game" -> {
clear_game_progress
start playing
}
choice "Level Select" -> goto level_select
}
}

scene playing {
layout {
row {
heading "Microban"
subheading level.label
}
sokoban
}

keys {
q Escape -> goto level_select
}

rules {
step sokoban
}
}

scene level_select {
layout {
text "Select a level"
button "Back" -> goto title
}

keys {
q Escape -> goto title
}
}
