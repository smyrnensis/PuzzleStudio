}

scene title {
  title "Simple Block Sliding Game"
  subtitle "by increpare"
  inputs {
    confirm <- Enter Space x
  }
  button "Play" -> input confirm
  rules {
    if input == confirm -> start levels in playing
  }
}

scene playing {
  state {
    board = puzzle main
  }
  view {
    row {
      title "Simple Block Sliding Game"
    }
    puzzle board
  }
  inputs {
    back <- Escape q
  }
  rules {
    board.rules
    if input == back -> goto title
  }
}
