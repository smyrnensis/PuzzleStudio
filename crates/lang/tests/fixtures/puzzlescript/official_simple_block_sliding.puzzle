title "Simple Block Sliding Game"
author increpare
homepage "www.increpare.com"

theme puzzlescript

sounds {
  sfx crate_move seed=36772507 type=puzzlescript
}

puzzle main {
layers {
  layer_1 = Background
  layer_2 = Target
  layer_3 = Player Wall Crate1 Crate2 Crate3
  layer_4 = slideleft slideup slideright slidedown
  layer_5 = nospawn
}

inputs {
  up <- w ArrowUp
  down <- s ArrowDown
  left <- a ArrowLeft
  right <- d ArrowRight
  restart <- r
}

group {
  crate = Crate1 Crate2 Crate3
  slidetag = slideleft slideup slideright slidedown
  obs = Wall crate
}

sprites {
  Background
    #90ee90 #008000
    11111
    01111
    11101
    11111
    10111

  Target
    #00008b
    .....
    .000.
    .0.0.
    .000.
    .....

  Wall
    #a46322 #493c2b
    00010
    11111
    01000
    11111
    00010

  Player
    #000000 #ffa500 #ffffff #0000ff
    .000.
    .111.
    22222
    .333.
    .3.3.

  Crate1
    #ffa500
    00000
    0...0
    0...0
    0...0
    00000

  Crate2
    #ffff00
    00000
    0...0
    0...0
    0...0
    00000

  Crate3
    #ffc0cb
    00000
    0...0
    0...0
    0...0
    00000

  slideright
    transparent

  slidedown
    transparent

  slideleft
    transparent

  slideup
    transparent

  nospawn
    #ff0000
    .....
    .....
    ..0..
    .....
    .....
}

win_conditions {
  no crate
}

on_level_start {
  once_all [ no Background ] -> [ Background ]
}

rules {
  input directions [ Player ] -> [ Player{>} ]
  [ Player{>} slidetag ] -> [ Player{>} ]
  [ Player{up} ] -> [ Player{up} slideup ] again
  [ Player{down} ] -> [ Player{down} slidedown ] again
  [ Player{left} ] -> [ Player{left} slideleft ] again
  [ Player{right} ] -> [ Player{right} slideright ] again
  [ slideup ] [ crate ] -> [ slideup ] [ crate{up} ] again
  [ slidedown ] [ crate ] -> [ slidedown ] [ crate{down} ] again
  [ slideleft ] [ crate ] -> [ slideleft ] [ crate{left} ] again
  [ slideright ] [ crate ] -> [ slideright ] [ crate{right} ] again
  repeat {
    [ crate{>} | obs{no directions} ] -> [ crate | obs ]
    [ Crate1{directions} | Crate1{no directions} ] -> [ Crate1 | Crate1 ]
    [ Crate2{directions} | Crate2{no directions} ] -> [ Crate2 | Crate2 ]
    [ Crate3{directions} | Crate3{no directions} ] -> [ Crate3 | Crate3 ]
  }
  move
  [ Target crate ] -> [ Target ]
}

on_level_clear {
  next_level
}

levels {
  legend {
    1 = Crate1
    2 = Crate2
    3 = Crate3
    , = nospawn
    . = Background
    # = Wall
    P = Player
    p = Player
    * = Crate1
    @ = Crate1 Target
    O = Target nospawn
    o = Target nospawn
    _ = empty
  }

