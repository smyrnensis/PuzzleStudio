}

scene title {
layout {
heading "Simple Block Sliding Game"
subheading "by increpare"
if has_progress_save {
choice "Continue" -> {
goto playing
}
}
choice "New Game" -> {
clear_game_progress
start playing
}
}
}

scene playing {
layout {
row {
heading "Simple Block Sliding Game"
}
puzzle board = main
}
keys {
Escape q -> goto title
}
rules {
step board
}
}
