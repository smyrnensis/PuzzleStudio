#ffa500
00000
0...0
0...0
0...0
00000

Crate2
#ffff00
00000
0...0
0...0
0...0
00000

Crate3
#ffc0cb
00000
0...0
0...0
0...0
00000

slideright
transparent

slidedown
transparent

slideleft
transparent

slideup
transparent

nospawn
#ff0000
.....
.....
..0..
.....
.....
}

sounds {
move crate -> sfx crate_move
}

win_conditions {
no crate
}

routine move {
repeat {
for l in layer1 layer2 layer3 layer4 layer5 {
once_all [ > l | | < l ] -> [ l | {__move_collision} | l ]
once_all [ > l | ; | ^ l ] -> [ l | {__move_collision} ; | l ]
[ > l | no l no {__move_collision} ] -> [ | l{no directions} ]
once_all [ > l ] -> [ l ]
}
once_all [ {__move_collision} ] -> [ ]
}
}

rules {
input [ Player ] -> [ > Player ]
[ > Player slidetag ] -> [ > Player ]
[ up Player ] -> [ up Player slideup ] again
[ down Player ] -> [ down Player slidedown ] again
[ left Player ] -> [ left Player slideleft ] again
[ right Player ] -> [ right Player slideright ] again
[ slideup ] [ crate ] -> [ slideup ] [ up crate ] again
[ slidedown ] [ crate ] -> [ slidedown ] [ down crate ] again
[ slideleft ] [ crate ] -> [ slideleft ] [ left crate ] again
[ slideright ] [ crate ] -> [ slideright ] [ right crate ] again
repeat {
[ > crate | obs{no directions} ] -> [ crate | obs ]
[ directions Crate1 | Crate1{no directions} ] -> [ Crate1 | Crate1 ]
[ directions Crate2 | Crate2{no directions} ] -> [ Crate2 | Crate2 ]
[ directions Crate3 | Crate3{no directions} ] -> [ Crate3 | Crate3 ]
}
move
[ Target crate ] -> [ Target ]
}

on_level_clear {
wait 0.3s
next_level
}

levels {
legend {
1 = Crate1 Background
2 = Crate2 Background
3 = Crate3 Background
, = nospawn Background
. = Background
# = Wall Background
P = Player Background
p = Player Background
* = Crate1 Background
@ = Crate1 Target Background
O = Target nospawn Background
o = Target nospawn Background
}

