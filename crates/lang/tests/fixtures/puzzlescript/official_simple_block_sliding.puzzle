title = "Simple Block Sliding Game"
author = "increpare"
homepage = "www.increpare.com"

theme = "puzzlescript"

sounds {
sfx crate_move { seed = 36772507; type = puzzlescript }
}

puzzle main {
slots {
layer1 = Background
layer2 = Target
layer3 = Player Wall Crate1 Crate2 Crate3
layer4 = slideleft slideup slideright slidedown
layer5 = nospawn
}

groups {
crate = Crate1 Crate2 Crate3
slidetag = slideleft slideup slideright slidedown
obs = Wall crate
}

sprites {
Background
#90ee90 #008000
11111
01111
11101
11111
10111

Target
#00008b
.....
.000.
.0.0.
.000.
.....

