title "Multiple Patterns"
author increpare
homepage "www.puzzlescript.net"

theme puzzlescript

sounds {
  sfx sumo_move seed=48878907 type=puzzlescript
}

puzzle main {
layers {
  layer_1 = Background
  layer_2 = Player Wall Sumo
}

keys {
  w ArrowUp -> up
  s ArrowDown -> down
  a ArrowLeft -> left
  d ArrowRight -> right
  r -> restart
}

sprites {
  Background
    #90ee90 #008000
    11111
    01111
    11101
    11111
    10111

  Wall
    #a46322 #493c2b
    00010
    11111
    01000
    11111
    00010

  Player
    #000000 #ffa500 #ffffff #0000ff
    .000.
    .111.
    22222
    .333.
    .3.3.

  Sumo
    #ffc0cb #ffffff
    ..0..
    00000
    .000.
    .111.
    .0.0.
}

on_level_start {
  once_all [ no Background ] -> [ Background ]
}

rules {
  input directions [ Player ] -> [ Player{>} ]
  [ Player{>} ] [ Sumo ] -> [ Player{>} ] [ Sumo{>} ]
  move
}

on_level_clear {
  wait 0.3s
  next_level
}

levels {
  legend {
    . = Background
    # = Wall
    P = Player
    S = Sumo
    _ = empty
  }

  ########
  #......#
  #......#
  #.P..S.#
  #......#
  #......#
  ########
}
}

scene title {
  layout {
    title "Multiple Patterns"
    subtitle "by increpare"
    if has_progress_save {
      choice "Continue" -> input continue_game
    }
    choice "New Game" -> input new_game
  }
  keys {
    Enter Space x -> continue_game
    n -> new_game
  }
  routine continue_game {
    goto playing
  }
  routine new_game {
    clear_game_progress
    goto playing(0)
  }
}

scene playing {
  layout {
    row {
      title "Multiple Patterns"
    }
    puzzle board = main
  }
  keys {
    Escape q -> back
  }
  rules {
    step board
  }
  routine back {
    goto title
  }
}
