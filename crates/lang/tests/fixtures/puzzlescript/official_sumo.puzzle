title = "Multiple Patterns"
author = "increpare"
homepage = "www.puzzlescript.net"

scene title {
layout {
heading "Multiple Patterns"
subheading "by increpare"
if has_progress_save {
choice "Continue" -> {
goto playing
}
}
choice "New Game" -> {
clear_game_progress
start playing
}
}
}

theme = "puzzlescript"

sounds {
sfx sumo_move { seed = 48878907; type = puzzlescript }
}

puzzle main {
layers {
layer1 = Background
layer2 = Player Wall Sumo
}

visuals {
Background
#90ee90 #008000
11111
01111
11101
11111
10111

Wall
#a46322 #493c2b
00010
11111
01000
11111
00010

Player
#000000 #ffa500 #ffffff #0000ff
.000.
.111.
22222
.333.
.3.3.

Sumo
#ffc0cb #ffffff
..0..
00000
.000.
.111.
.0.0.
}

sounds {
move Sumo -> sfx sumo_move
}

routine move {
repeat {
for l in layer1 layer2 {
once_all [ > l | | < l ] -> [ l | {__move_collision} | l ]
once_all [ > l | ; | ^ l ] -> [ l | {__move_collision} ; | l ]
[ > l | no l no {__move_collision} ] -> [ | l{no directions} ]
once_all [ > l ] -> [ l ]
}
once_all [ {__move_collision} ] -> [ ]
}
}

rules {
input [ Player ] -> [ > Player ]
[ > Player ] [ Sumo ] -> [ > Player ] [ > Sumo ]
move
}

on_level_clear {
wait 0.3s
next_level
}

levels {
legend {
A = Background
# = Wall Background
P = Player Background
S = Sumo Background
}

########
#AAAAAA#
#AAAAAA#
#APAASA#
#AAAAAA#
#AAAAAA#
########
}
}

scene playing {
layout {
row {
heading "Multiple Patterns"
}
puzzle board = main
}
keys {
Escape q -> goto title
}
rules {
step board
}
}
