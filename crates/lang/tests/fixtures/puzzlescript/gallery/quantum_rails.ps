=======
LEGEND
=======

( What can Rails and Cores be connected to? )
Grab = Player or Coin or Rock or Wall

( What can move? )
Move = Player or Coin or Rock

( What stops different objects? )
StopP = Player or         Rock or Wall
StopC =           Coin or Rock or Wall
StopR = Player or Coin or Rock or Wall

( Cores and Rails are both Tech)
TechV = CoreV or RailV
TechH = CoreH or RailH
Tech = TechV or TechH

( Which Rails are locked to Cores and which Cores are holding Rails )
Lock = LockV or LockH
Hold = HoldV or HoldH

( Which objects are stuck )
Stuck = StuckU1 or StuckD1 or StuckL1 or StuckR1 or StuckV1 or StuckH1

( Falling animations )
PlayerFall = PlayerFall1 or PlayerFall2 or PlayerFall3
CoinFall   = CoinFall1   or CoinFall2   or CoinFall3
RockFall   = RockFall1   or RockFall2   or RockFall3

( Losing states )
Lost = PlayerFall or CoinFall



. = Background
x = Void

a = Player
b = Player and RailV
c = Player and RailH
d = Player and RailV and RailH
e = Player and CoreV
f = Player and CoreH
g = Player and CoreV and CoreH

0 = Coin
1 = Coin and RailV
2 = Coin and RailH
3 = Coin and RailV and RailH
4 = Coin and CoreV
5 = Coin and CoreH
6 = Coin and CoreV and CoreH

o = Rock
│ = Rock and RailV
─ = Rock and RailH
┼ = Rock and RailV and RailH
║ = Rock and CoreV
═ = Rock and CoreH
╬ = Rock and CoreV and CoreH

▫ = Wall
▯ = Wall and RailV
▭ = Wall and RailH
□ = Wall and RailV and RailH
▮ = Wall and CoreV
▬ = Wall and CoreH
■ = Wall and CoreV and CoreH



