title = "Basic PS Sokoban"

theme = "puzzlescript"

puzzle main {
layers {
layer1 = Background
layer2 = Target
layer3 = Player Wall Crate
}

sprites {
Background
#000000
.....
.....
.....
.....
.....

Target
#ffff00
.....
.000.
.0.0.
.000.
.....

Wall
#808080
00000
00000
00000
00000
00000

Crate
#a06020
00000
0...0
0...0
0...0
00000

Player
#0000ff
.000.
.0.0.
.000.
..0..
.0.0.
}

win_conditions {
all Target on Crate
}

routine move {
repeat {
for l in layer1 layer2 layer3 {
once_all [ > l | | < l ] -> [ l | {__move_collision} | l ]
once_all [ > l | ; | ^ l ] -> [ l | {__move_collision} ; | l ]
[ > l | no l no {__move_collision} ] -> [ | l{no directions} ]
once_all [ > l ] -> [ l ]
}
once_all [ {__move_collision} ] -> [ ]
}
}

rules {
input [ Player ] -> [ > Player ]
[ > Player | Crate ] -> [ > Player | > Crate ]
move
}

on_level_clear {
wait 0.3s
next_level
}

levels {
legend {
. = Background
# = Wall Background
P = Player Background
B = Crate Background
T = Target Background
* = Crate Target Background
}

#######
#P.BT.#
#..*..#
#######
}
}

scene title {
layout {
heading "Basic PS Sokoban"
if has_progress_save {
choice "Continue" -> {
goto playing
}
}
choice "New Game" -> {
clear_game_progress
start playing
}
}
}

scene playing {
layout {
row {
heading "Basic PS Sokoban"
}
puzzle board = main
}
keys {
Escape q -> goto title
}
rules {
step board
}
}
