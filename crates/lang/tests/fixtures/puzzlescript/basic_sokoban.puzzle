title "Basic PS Sokoban"

theme puzzlescript

puzzle main {
layers {
  layer_1 = Background
  layer_2 = Target
  layer_3 = Player Wall Crate
}

inputs {
  up <- w ArrowUp
  down <- s ArrowDown
  left <- a ArrowLeft
  right <- d ArrowRight
  restart <- r
}

sprites {
  Background
    #000000
    .....
    .....
    .....
    .....
    .....

  Target
    #ffff00
    .....
    .000.
    .0.0.
    .000.
    .....

  Wall
    #808080
    00000
    00000
    00000
    00000
    00000

  Crate
    #a06020
    00000
    0...0
    0...0
    0...0
    00000

  Player
    #0000ff
    .000.
    .0.0.
    .000.
    ..0..
    .0.0.
}

win_conditions {
  all Target on Crate
}

on_level_start {
  once_all [ no Background ] -> [ Background ]
}

rules {
  input directions [ Player ] -> [ Player{>} ]
  [ Player{>} | Crate ] -> [ Player{>} | Crate{>} ]
  move
}

on_level_clear {
  wait 0.3s
  next_level
}

levels {
  legend {
    . = Background
    # = Wall
    P = Player
    B = Crate
    T = Target
    * = Crate Target
    _ = empty
  }

  #######
  #P.BT.#
  #..*..#
  #######
}
}

scene title {
  view {
    title "Basic PS Sokoban"
    if game.has_progress_save {
      choice "Continue" -> input continue_game
    }
    choice "New Game" -> input new_game
  }
  inputs {
    continue_game <- Enter Space x
    new_game <- n
  }
  rules {
    if input == continue_game -> goto playing
    if input == new_game -> {
      clear_game_progress
      goto playing(0)
    }
  }
}

scene playing {
  state {
    board = puzzle main
  }
  view {
    row {
      title "Basic PS Sokoban"
    }
    puzzle board
  }
  inputs {
    back <- Escape q
  }
  rules {
    step board
    if input == back -> goto title
  }
}
