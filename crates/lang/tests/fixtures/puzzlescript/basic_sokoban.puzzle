title = "Basic PS Sokoban"

theme puzzlescript

puzzle main {
layers {
Background
Target
Player Wall Crate
}

sprites {
Background
#000000
.....
.....
.....
.....
.....

Target
#ffff00
.....
.000.
.0.0.
.000.
.....

Wall
#808080
00000
00000
00000
00000
00000

Crate
#a06020
00000
0...0
0...0
0...0
00000

Player
#0000ff
.000.
.0.0.
.000.
..0..
.0.0.
}

win_conditions {
no [ Target no Crate ]
}

on_level_start {
once_all [ no Background ] -> [ Background ]
}

rules {
input directions [ Player ] -> [ > Player ]
[ > Player | Crate ] -> [ > Player | > Crate ]
move
}

on_level_clear {
wait 0.3s
next_level
}

levels {
legend {
. = Background
# = Wall
P = Player
B = Crate
T = Target
* = Crate Target
_ = empty
}

#######
#P.BT.#
#..*..#
#######
}
}

scene title {
layout {
title = "Basic PS Sokoban"
if has_progress_save {
choice "Continue" -> continue_game
}
choice "New Game" -> new_game
}
routine continue_game {
goto playing
}
routine new_game {
clear_game_progress
goto playing(0)
}
}

scene playing {
layout {
row {
title = "Basic PS Sokoban"
}
puzzle board = main
}
keys {
Escape q -> back
}
rules {
step board
}
routine back {
goto title
}
}
