≃ = Puddle
o = Hole
! = Button
+ = GateC
O = GateO
$ = TimeMachine:F
% = TimeMachine:B
P = You:F Start
Q = You:B Start
β = Ball TargetBall
χ = Crate TargetCrate
: = Crack TargetCrate
; = Pond TargetCrate
& = Ball TargetCrate
1 = Count:1
2 = Count:2
3 = Count:3
∞ = Count:Inf
∘ = Ink:F
• = Ink:B
@ = Crate TargetCrate
# = Wall
⋆ = Wall Star
. = empty
}

