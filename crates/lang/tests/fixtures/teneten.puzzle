scene title {
layout {
heading "TENETEN"
subheading "by smyrnensis"
if has_progress_save {
choice "Continue" -> continue_game
}
choice "New Game" -> new_game
choice "Level Select" -> goto level_select
}
routine continue_game {
goto playing
}
routine new_game {
clear_game_progress
goto playing(0)
}
}



scene playing {
layout {
row {
heading "TENETEN"
}
puzzle board = main
}
keys {
Escape q -> back
}
rules {
step board
}
routine back {
goto title
}
}

scene level_select {
layout {
level_menu {
show_index = true
show_solved = true
button "Back" -> goto title
}
}
}
