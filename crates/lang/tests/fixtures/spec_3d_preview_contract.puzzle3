title = "Microban 3D Preview Contract"

puzzle sokoban {
dimension = 3
render {
  camera {
    yaw = 10
    pitch = 55
    roll = 20
    zoom = 1.1
  }
}

slots {
  floor = Floor
  target = Goal
  Player Box Wall
}

groups {
  solid = Player Box Wall
}

rules {
  input horizontal [ Player | Box | no solid ] -> [ | Player | Box ]
  input horizontal [ Player | no solid ] -> [ | Player ]
}
}

levels microban of sokoban {
legend {
. = empty
, = Floor
G = Floor Goal
P = Player
B = Box
# = Wall
}

level "microban_01" {
