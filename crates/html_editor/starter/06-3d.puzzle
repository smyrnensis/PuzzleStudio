const title = "Microban 3D"
const author = "Levels by David Skinner"

theme = puzzlescript
theme {
background_color = #ffffff
text_color = #000
}

scene title {
layout {
  heading "Microban 3D"
  choice "Start" -> start playing
}
}

puzzle sokoban {
dimension = 3
render {
camera {
	yaw = 0
	pitch = 5
	zoom = 1
}
}

layers {
floor = Floor
target = Goal
Player Box Wall
}

groups {
solid = Player Box Wall
}

rules {
once input horizontal [ Player | Box | no solid ] -> [ | Player | Box ]
once input horizontal [ Player | no solid ] -> [ | Player ]
}

win_conditions {
some Goal
no down [ no Box | Goal ]
}

on_level_clear {
wait 0.3s
message "WIN"
goto title
}
}


scene playing {
keys {
q Escape -> goto title
}
layout {
heading "Microban 3D"
sokoban
}
rules {
step sokoban
}
}

levels microban of sokoban {
legend {
, = Floor
G = Floor Goal
P = Player
B = Box
# = Wall
}

level "microban 1" {
####..
#..#..
#..###
#BP..#
#..B.#
#..###
####..
-
,,,,,,
,,G,,,
,,,,,,
,G,,,,
,,,,,,
,,,,,,
,,,,,,
}
}

