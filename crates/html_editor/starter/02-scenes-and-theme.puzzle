// SCENES AND THEME
// EXPECT: The title screen opens the game or its level list.
// TRY: Change accent_color or add another choice to the title scene.

title = "02 — Scenes and Theme"
subtitle = "Build the screens around a puzzle"

theme {
preset = "puzzlescript"
accent_color = #e85d75
background_color = #fff7ed
text_color = #292524
}

scene title {
layout {
heading title
subheading subtitle
choice "Play" -> goto playing
choice "Choose level" -> goto level_select
}
}

puzzle main {
layers {
Player Wall
}

visuals {
visual Player {
colors = #008751
shape = {
.000.
.000.
00000
.000.
.0.0.
}
}

visual Wall {
colors = #57534e
shape = {
0
}
}
}

rules {
once input [ Player | no Wall ] -> [ | Player ]
}

levels {
legend {
. = empty
# = Wall
P = Player
}

level "small room"
#####
#P..#
#...#
#####

level "big room"
#########
#.......#
#.......#
#..P....#
#.......#
#.......#
#.......#
#########
}
}

scene playing {
keys {
q Escape -> goto title
}
layout {
heading "Playing"
main
caption "Arrow keys move. Escape returns to the title."
}
}

scene level_select {
layout {
heading "Choose a level"
level_menu
button "Back" -> goto title
}
}
