// SCENES AND THEME
// EXPECT: The title screen opens the game or its level list.
// TRY: Change accent_color or add another choice to the title scene.

title = "02 — Scenes and Theme"
subtitle = "Build the screens around a puzzle"

theme {
preset = "clean"
accent_color = #e85d75
background_color = #fff7ed
text_color = #292524
}

puzzle board {
layers {
Player Wall
}

sprites {
Player
#e85d75
.000.
00000
.000.
.0.0.
.0.0.

Wall
#57534e
00000
00000
00000
00000
00000
}

rules {
input [ Player | no Wall ] -> [ | Player ]
}

levels {
legend {
. = empty
# = Wall
P = Player
}

level "small room"
#####
#P..#
#...#
#####
}
}

scene title {
layout {
heading title
subheading subtitle
choice "Play" -> goto playing
choice "Choose level" -> goto level_select
}
}

scene playing {
keys {
Escape -> goto title
}
layout {
heading "Playing"
board
caption "Arrow keys move. Escape returns to the title."
}
rules {
step board
}
}

scene level_select {
layout {
heading "Choose a level"
level_menu
button "Back" -> goto title
}
}
