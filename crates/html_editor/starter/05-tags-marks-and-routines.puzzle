const title = "05 — Tags, Marks, and Routines"
const subtitle = "Describe variants and split a transition into named stages"

puzzle keys_and_doors {

tags {
color = red blue
}

groups {
pushable = Key:*
solid = Key:* Player
stop = Wall Door:*
}

layers {
Floor
Flag
Key:color
Player Door:color Wall
}

rules {
input [ Player ] -> [ Player{>} ]
[ Player{>} | pushable ] -> [ Player{>} | pushable{>} ]
[ Key:color{>} | Door:color ] -> [  |  ]
[ solid{>} | no solid no stop ] -> [  | solid ]
}

win_conditions {
all Player on Flag
}

on_level_clear {
wait 0.1s
message "win"
next_level
}

visuals {
Floor
#f8fafc

visual Player {
colors = #1d2b53
shape = {
.000.
.000.
00000
.000.
.0.0.
}
}

visual Key:red {
colors = #ef4444
shape = {
.....
.00..
.0000
.00.0
.....
}
}

visual Key:blue {
colors = #3b82f6
shape = {
.....
.00..
.0000
.00.0
.....
}
}

visual Door:red {
colors = #ef4444
shape = {
.000.
.0.0.
.0.0.
.0.0.
.000.
}
}

visual Door:blue {
colors = #3b82f6
shape = {
.000.
.0.0.
.0.0.
.0.0.
.000.
}
}

visual Wall {
colors = #64748b
shape = {
00000
00000
00000
00000
00000
}
}

visual Flag {
colors = #ab5236 #ffec27
shape = {
01111
01111
01111
0....
0....
}
}
}

on_level_start {
[ no Floor ] -> [ Floor ]
}

levels {
legend {
. = empty
# = Wall
P = Player
r = Key:red
b = Key:blue
R = Door:red
B = Door:blue
F = Flag
}

level "matching colors"
#########
#P.r.R..#
#..b.B.F#
#########
}
}
