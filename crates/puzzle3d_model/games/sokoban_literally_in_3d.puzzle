title "Microban Basic 3D"

model puzzle3 sokoban_literally_in_3d {
  render {
    camera {
      yaw 34
      pitch 38
      zoom 1.1
      interactive_look false
      interactive_zoom false
    }
    grid {
      occupied_cells true
    }
  }

  layers {
    floor = Floor
    target = Goal
    solid = Player Box Wall
  }

  group solid = Player Box Wall

  rules {
    input horizontal [ Player | Box | no solid ] -> [ | Player | Box ]
    input horizontal [ Player | no solid ] -> [ | Player ]
  }

  win_conditions {
    some Goal
    all Goal on down [ Box | Goal ]
  }

  on_level_clear {
    if win_conditions -> next_level
  }
}

scene title {
  view {
    title "Microban Basic 3D"
    button "Start" -> start microban in playing
    button "Level Select" -> goto level_select
  }
}

scene level_select {
  state {
    board = puzzle3 sokoban_literally_in_3d
  }

  view {
    title "Select Level"
    level_menu microban -> start microban in playing
    button "Back" -> goto title
  }
}

scene playing {
  state {
    board = puzzle3 sokoban_literally_in_3d
  }

  keys {
    q = goto level_select
    Escape = goto level_select
  }

  view {
    puzzle3 board
  }
}

levels3 microban of sokoban_literally_in_3d {
  legend {
    _ = empty
    . = Floor
    G = Floor Goal
    P = Player
    B = Box
    # = Wall
  }

  level microban_01 {
