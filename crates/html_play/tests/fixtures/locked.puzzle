scene title {
layout {
	title = title
	choice "Play" -> goto playing
	// choice "New Game" -> {
			// clear_game_progress
			// goto playing
		// }
	choice "Levels" -> goto level_select
}
on_scene_start {
	stop_music locked_room
}
}

scene playing {
	layout {
		main
	}
	keys {
		q Escape -> {
		stop_music locked_room
		goto level_select
		}
	}
	on_scene_start {
		play_music locked_room
	}
	rules {
		step main
	}
}


scene level_select {
			layout {
				text "Select a level"
				choice "Title" -> goto title
			}
		keys {
			q Escape -> goto title
		}
	on_scene_start {
		stop_music locked_room
	}
}
