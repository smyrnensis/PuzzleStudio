const title = "Stuck Room"

default_wait_time = 100ms

theme = clean
theme {
accent_color = #c4d0cb
background_color = #454545
text_color = #c4d0cb
}

sounds {
sfx push { seed = 301193; type = hit; volume = 0.2 }
sfx bump { seed = 945816; type = hit; volume = 0.3 }
sfx clear { seed = clear; type = jump }
sfx locked { seed = locked; type = lock }
sfx fall { seed = fall; type = hit }
sfx restart { seed = 560993; type = jump; volume = 0.8 }
sfx undo { seed = 613236; type = select; volume = 0.50 }
music locked_room { seed = LockedRoom; bars = 64; height = 0.00; bpm = 90; volume = 4 }
}

puzzle main {

tags {
state = open close
num = 0...5
}

render {
tween = true
tween_duration = 50ms
}

map rotate directions {
up -> right
right -> down
down -> left
left -> up
}

marks {
checked
}

sounds {
restart -> sfx restart
undo -> sfx undo
}

layers {
@Floor @Floor2
@Lock
room = Room Room:state
Carpet
Crack Hole
Goal:state Door:state
GoalCount:num
Key
solid = Player Box:state Pull:state Wall Gate:num
@Count:num
OnPlayer CanEnter VirtualBox
each @LockedFrame:directions @LockedCorner:directions @WallFrame:directions @WallCorner:directions
@Debug
}

groups {
separate = Box:* Pull:* Wall Gate:* Hole
fixed = Box:close Pull:close Wall Gate:*
cantgo = Box:* Pull:* Wall Gate:*
cantpush = Box:* Pull:* Wall Gate:* Carpet
heavy = Box:* Pull:* Player
nonplayer = Box:* Pull:*
box = Box:* VirtualBox
}

var locked_room_count = 0
var previous_count = 0

routine @initial_displays {
once [ no @Floor ] -> [ @Floor ]
repeat {
[ @Floor | no @Floor2 ] -> [ @Floor | @Floor2 ]
[ @Floor2 | no @Floor ] -> [ @Floor2 | @Floor ]
}
[ Wall | no Wall ] -> [ Wall @WallFrame:> |  ] 
[ Wall | Wall ; Wall | no Wall ] -> [ Wall @WallCorner:> | Wall ; Wall |  ]
}

routine check_OnPlayer {
[ OnPlayer ] -> [  ]
once [ Player ] -> [ Player OnPlayer ]
repeat {
[ OnPlayer | no OnPlayer no separate ] -> [ OnPlayer | OnPlayer ] 
[ OnPlayer | Box:open | no cantpush ] -> [ OnPlayer | Box:open  OnPlayer |  ]
}
}

routine check_stuck {
for obj in Box Pull {
[ obj:close ] -> [ obj:open ]
}
[ OnPlayer | Box:open{no checked} | no cantpush ] -> [ OnPlayer | Box:open{checked} |  ]

[ no cantgo | OnPlayer | Pull:open{no checked} ] -> [  | OnPlayer | Pull:open{checked} ]
[ no cantpush | Box:open | OnPlayer | Pull:open{no checked} ] -> [ | = | = | Pull:open{checked} ]

for obj in Box Pull {
[ obj:open{no checked} ] -> [ obj:close ]
[ obj:open{checked} ] -> [ obj:open ]
}
}

routine compute_locked_rooms {
once_all [ Room:close no separate ] -> [ Room:close @Lock ]
locked_room_count = 0
[ room ] -> [  ]
once_all [ no separate ] -> [ Room ]
for obj in Box Pull {
[ obj:open | Room ] -> [ obj:open | Room:open ]
}
[ OnPlayer Crack Room ] -> [ OnPlayer Crack Room:open ]
[ Room:open | Room ] -> [ Room:open | Room:open ] 
repeat {
	once [ Room ] -> [ Room:close ] locked_room_count += 1
	[ Room:close | Room ] -> [ Room:close | Room:close ]
}
once [ Room:close no @Lock ] -> [ Room:close ] sfx locked
once [ Room:open @Lock ] -> [ = ] sfx locked
[ @Lock ] -> [  ]
}

routine @display_locked_frame {
[ @LockedFrame:* ] -> [  ] 
[ @LockedCorner:* ] -> [  ]
[ Room:close | no Room:close ] 
-> [ Room:close @LockedFrame:> |  ]
[ Room:close | @LockedFrame:down ; @LockedFrame:right |  ]
-> [ Room:close @LockedCorner:right | @LockedFrame:down ; @LockedFrame:right |  ]
}

routine move {
repeat {
[ > nonplayer | no solid ] -> [  | nonplayer ] sfx push
[ > Player | no solid ] -> [  | Player ]
}
[ > solid ] -> [ solid ] sfx bump
wait
}

routine open_gate {
for n in 1...5 {
	if some([ Gate:n{checked} ]) {
		if locked_room_count == n {
			[ @Count:* ] -> [ @Count:locked_room_count ]
			[ Gate:n{checked} ] -> [  ]
		} else {
			[ Gate:n{checked} ] -> [ Gate:n ]
		}
	}
}
}

routine check_win {
for n in 1...5 {
	if locked_room_count == n {
		[ Goal:close GoalCount:n ] -> [ Goal:open GoalCount:n ]
	}
}
[ Player Goal:open ] -> win
}

routine check_crack {
[ Crack heavy ] -> [ Crack{checked} heavy ]
}

routine change_crack {
[ Crack{checked} no heavy ] -> [ Hole ]
}

routine fall {
[ Hole heavy ] -> wait 0.1s
[ Hole heavy ] -> [ ] sfx fall
}

on_level_start {
@initial_displays
check_OnPlayer
check_stuck
locked_room_count = 0
compute_locked_rooms
@display_locked_frame
}

rules {
check_crack

input [ Player ] -> [ > Player ]

[ > Player | Gate:* ] -> [ > Player | Gate:*{checked} ] open_gate

[ > Player | Box:open ] -> [ > Player | > Box:open ]
[ < Player | Pull:open ] -> [ < Player | < Pull:open ]
[ > nonplayer | Carpet ] -> [ nonplayer | Carpet ] sfx bump
move

fall
change_crack


check_OnPlayer
check_stuck
compute_locked_rooms
@display_locked_frame
check_win
}


lose_conditions {
no ([ *:open ]) and no([ Goal:open ])
}

on_level_clear {
sfx clear
wait 0.35s
next_level
}

on_last_level_clear {
sfx clear
wait 0.35s
message "Thanks for playing!"
goto level_select
}
}

levels {
legend {
. = empty
P = Player
B = Box:open
C = Pull:open
$ = Carpet
# = Wall
* = Crack
1 = Goal:close GoalCount:1
2 = Goal:close GoalCount:2
3 = Goal:close GoalCount:3
4 = Goal:close GoalCount:4
a = Gate:1
b = Gate:2
}

