const title = "Standalone Visibility"

scene title {
layout {
  choice "Start" -> start playing
}
}

puzzle board {
render {
  tween = true
  tween_duration = 10s
}
layers {
  actor = Player
}
rules {
  input horizontal [ Player | no Player ] -> [ | Player ]
}
}

visuals simple of board {
Player
#5cf
0
}

scene playing {
layout {
  board
}
rules {
  step board
}
}

levels main of board {
legend {
. = empty
P = Player
}
level "one" {
P.
}
}
