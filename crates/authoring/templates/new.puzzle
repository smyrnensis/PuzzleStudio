title "New Puzzle"

puzzle main {
layers {
base = Floor
}

sprites {
}

rules {
}

levels {
}
}

scene title {
layout {
title
button "Start" -> goto playing
button "Levels" -> goto level_select
}

keys {
Enter Space -> goto playing
l -> goto level_select
}
}

scene level_select {
layout {
text "Select Level"
level_menu
button "Back" -> goto title
}

keys {
Escape q -> goto title
}
}

scene playing {
state {
board = puzzle main
}

layout {
board
}

keys {
Escape q -> goto title
}
}
