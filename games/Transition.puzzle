routine __ps_main once {
  [ Player1 death ] [ Deadplayer1 ] -> [ death ] [ Player1 playerreset ]
  [ Player1 death ] [ Deadplayer2 ] -> [ death ] [ Player2 player2reset ]
  [ Player1 death ] [ gdeadplayer ] -> [ death ] [ gplayer ]
  [ Player2 death ] [ Deadplayer1 ] -> [ death ] [ Player1 playerreset ]
  [ Player2 death ] [ Deadplayer2 ] -> [ death ] [ Player2 player2reset ]
  [ Player2 death ] [ gdeadplayer ] -> [ death ] [ gplayer ]
  [ gplayer death ] [ Deadplayer1 ] -> [ death ] [ Player1 playerreset ]
  [ gplayer death ] [ Deadplayer2 ] -> [ death ] [ Player2 player2reset ]
  [ gplayer death ] [ gdeadplayer ] -> [ death ] [ gplayer ]
  [ pplayer1 death ] [ piplayer2 ] -> [ piplayer1 death ] [ pplayer2 ]
  [ pplayer2 death ] [ piplayer1 ] -> [ piplayer2 death ] [ pplayer1 ]
  [ player death ] -> [ death ]
  [ Player1 death ] [ playerreset ] -> [ death ] [ ]
  [ Player2 death ] [ player2reset ] -> [ death ] [ ]
  [ player{>} | pushable ] -> [ player{>} | pushable{>} ]
  [ pushable{>} | pushable ] -> [ pushable{>} | pushable{>} ]
  [ key{>} | lock ] -> [ | ]
  [ pplayer1{>} ] [ piplayer2 ] -> [ pplayer1{>} ] [ piplayer2{>} ]
  [ pplayer2{>} ] [ piplayer1 ] -> [ pplayer2{>} ] [ piplayer1{>} ]
  [ pkey1{>} ] [ pikey2 ] -> [ pkey1{>} ] [ pikey2{>} ]
  [ pkey2{>} ] [ pikey1 ] -> [ pkey2{>} ] [ pikey1{>} ]
  [ pcrate1{>} ] [ picrate2 ] -> [ pcrate1{>} ] [ picrate2{>} ]
  [ > pcrate2 ] [ picrate1 ] -> [ > pcrate2 ] [ picrate1{>} ]
  [ Target crate ] [ nflag ] -> [ Target crate ] [ flag ]
  [ Target no crate ] [ flag ] -> [ Target ] [ nflag ]
  move
  [ Player1 death ] [ Deadplayer1 ] [ playerreset ] -> [ death ] [ Player1 playerreset ] [ ]
  down [ pplayer1 | ... | wall2 ] [ piplayer2 ] -> [ | ... | wall2 ] [ ]
  down [ pplayer2 | ... | Wall1 ] [ piplayer1 ] -> [ | ... | Wall1 ] [ ]
  down [ Deadplayer1 | ... | wall2 ] [ playerreset ] [ Player1 death ] -> [ Player2 player2reset | ... | wall2 ] [ ] [ death ]
  down [ Deadplayer2 | ... | Wall1 ] [ player2reset ] [ Player2 death ] -> [ Deadplayer1 playerreset | ... | Wall1 ] [ ] [ death ]
  down [ playerreset gobject | ... | Wall1 ] [ Player1 | ... | wall2 ] [ Deadplayer1 | ... | wall2 ] -> [ gobject | ... | Wall1 ] [ | ... | wall2 ] [ Player2 player2reset | ... | wall2 ]
  down [ Player1 | ... | wall2 ] [ gobject playerreset ] [ Deadplayer1 ] -> [ | ... | wall2 ] [ gobject ] [ Player1 playerreset ]
  down [ player2reset gobject | ... | wall2 ] [ Player2 | ... | Wall1 ] [ Deadplayer2 | ... | Wall1 ] -> [ gobject | ... | wall2 ] [ | ... | Wall1 ] [ Player1 playerreset | ... | Wall1 ]
  down [ player2reset gobject | ... | wall2 ] [ Player2 | ... | Wall1 ] [ Deadplayer1 | ... | Wall1 ] -> [ gobject | ... | wall2 ] [ | ... | Wall1 ] [ Player1 playerreset | ... | Wall1 ]
  down [ Player2 | ... | Wall1 ] [ gobject player2reset ] [ Deadplayer2 ] -> [ | ... | Wall1 ] [ gobject ] [ Player2 player2reset ]
  down [ death player ] [ Deadplayer1 | ... | wall2 ] -> [ death ] [ Player2 player2reset | ... | wall2 ]
  down [ pkey1 | ... | wall2 ] [ pikey2 ] -> [ | ... | wall2 ] [ ]
  down [ pkey2 | ... | Wall1 ] [ pikey1 ] -> [ | ... | Wall1 ] [ ]
  down [ wall2 | ... | player ] [ pkey1 ] [ pikey2 ] -> [ wall2 | ... | player ] [ pikey1 ] [ pkey2 ]
  down [ Wall1 | ... | player ] [ pikey1 ] [ pkey2 ] -> [ Wall1 | ... | player ] [ pkey1 ] [ pikey2 ]
  down [ pcrate1 | ... | wall2 ] [ picrate2 ] -> [ | ... | wall2 ] [ ]
  down [ pcrate2 | ... | Wall1 ] [ picrate1 ] -> [ | ... | Wall1 ] [ ]
  down [ wall2 | ... | player ] [ pcrate1 ] [ picrate2 ] -> [ wall2 | ... | player ] [ picrate1 ] [ pcrate2 ]
  down [ Wall1 | ... | player ] [ picrate1 ] [ pcrate2 ] -> [ Wall1 | ... | player ] [ pcrate1 ] [ picrate2 ]
  down [ player | ... | wall2 ] [ Crate1 ] -> [ player | ... | wall2 ] [ ]
  down [ player | ... | wall2 ] [ cratespawn1 no Crate1 no gobject ] -> [ player | ... | wall2 ] [ cratespawn1 Crate1 ]
  down [ player | ... | Wall1 ] [ crate2 ] -> [ player | ... | Wall1 ] [ ]
  down [ player | ... | Wall1 ] [ cratespawn2 no crate2 no gobject ] -> [ player | ... | Wall1 ] [ cratespawn2 crate2 ]
  down [ player | ... | wall2 ] [ key1 ] -> [ player | ... | wall2 ] [ ]
  down [ player | ... | wall2 ] [ keyspawn1 no key1 no gobject ] -> [ player | ... | wall2 ] [ keyspawn1 key1 ]
  down [ player | ... | Wall1 ] [ key2 ] -> [ player | ... | Wall1 ] [ ]
  down [ player | ... | Wall1 ] [ keyspawn2 no key2 no gobject ] -> [ player | ... | Wall1 ] [ keyspawn2 key2 ]
  down [ player | ... | wall2 ] [ lock1 ] -> [ player | ... | wall2 ] [ ]
  down [ player | ... | wall2 ] [ lockspawn1 no lock1 no gobject ] -> [ player | ... | wall2 ] [ lockspawn1 lock1 ]
  down [ player | ... | Wall1 ] [ lock2 ] -> [ player | ... | Wall1 ] [ ]
  down [ player | ... | Wall1 ] [ lockspawn2 no lock2 no gobject ] -> [ player | ... | Wall1 ] [ lockspawn2 lock2 ]
  down [ player | ... | wall2 ] [ Wall1 ] -> [ player | ... | wall2 ] [ ]
  down [ player | ... | wall2 ] [ wallspawn1 no Wall1 no gobject ] -> [ player | ... | wall2 ] [ wallspawn1 Wall1 ]
  down [ player | ... | Wall1 ] [ wall2 ] -> [ player | ... | Wall1 ] [ ]
  down [ player | ... | Wall1 ] [ wallspawn2 no wall2 no gobject ] -> [ player | ... | Wall1 ] [ wallspawn2 wall2 ]
  down [ player | ... | wall2 ] [ Deadplayer1 ] -> [ player | ... | wall2 ] [ ]
  down [ player | ... | wall2 ] [ deadplayer1reset no Deadplayer1 no gobject ] -> [ player | ... | wall2 ] [ deadplayer1reset Deadplayer1 ]
  down [ player | ... | Wall1 ] [ Deadplayer2 ] -> [ player | ... | Wall1 ] [ ]
  down [ player | ... | Wall1 ] [ deadplayer2reset no Deadplayer2 no gobject ] -> [ player | ... | Wall1 ] [ deadplayer2reset Deadplayer2 ]
  down [ Player1 | ... | wall2 ] [ playerreset no gobject ] -> [ | ... | wall2 ] [ playerreset Player1 ]
  down [ Player1 | ... | wall2 ] [ playerreset gobject ] -> [ | ... | wall2 ] [ playerreset gobject ]
  down [ Player2 | ... | Wall1 ] [ player2reset ] -> [ | ... | Wall1 ] [ player2reset Player2 ]
  [ player flag ] -> win
}

on_level_start {
  once_all [ no Background ] -> [ Background ]
  __ps_main
}

rules {
  input directions [ player ] -> [ player{>} ]
  __ps_main
}

