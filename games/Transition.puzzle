  #...........#z...........z
  #...........#z...........z
  #...........#z...........z
  #############zzzzzzzzzzzzz

  message "Thanks For Playing"
  #############zzzzzzzzzzzzz
  #...........#z.##........z
  #..d..d..d..#z.#.#...#...z
  #..dd.d.....#z.##....#...z
  #..d.dd..d..#z.#.#...#...z
