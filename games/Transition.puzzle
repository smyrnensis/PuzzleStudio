title Transition
author NinaBirb

theme puzzlescript

sounds {
  sfx pushable_move seed=36772507 type=puzzlescript
}

puzzle main {
layers {
  layer_1 = Background
  layer_2 = playerreset
  layer_3 = player2reset
  layer_4 = reset1 reset2 cratespawn1 cratespawn2 lockspawn1 lockspawn2 keyspawn1 keyspawn2 wallspawn1 wallspawn2 deadplayer1reset deadplayer2reset
  layer_5 = Target flag nflag death
  layer_6 = gplayer Player1 Wall1 wall2 Crate1 crate2 gcrate lock1 lock2 key1 key2 gkey glock gwall pcrate1 pkey1 pkey2 Player2 Deadplayer2 gdeadplayer pplayer1 pplayer2 Deadplayer1
  layer_7 = picrate1 picrate2
  layer_8 = pikey1 pikey2
  layer_9 = piplayer2 piplayer1
}

inputs {
  up <- w ArrowUp
  down <- s ArrowDown
  left <- a ArrowLeft
  right <- d ArrowRight
  restart <- r
}

group {
  key = key1 key2 gkey pkey1 pkey2
  lock = lock1 lock2 glock
  crate = Crate1 crate2 gcrate pcrate1
  pushable = key1 key2 Crate1 crate2 gcrate gkey pcrate1 pkey1 pkey2 Deadplayer1 Deadplayer2 gdeadplayer
  player = Player1 gplayer Player2 pplayer1 pplayer2
  gobject = gcrate gkey gdeadplayer
}

