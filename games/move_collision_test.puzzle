title = "Move Collision Test"
author = "PuzzleStudio"

default_wait_time = 100ms

sounds {
sfx move { seed = move; type = jump }
}

puzzle move_collision {
layers {
actor = Chain Left Right UpMover Wall
}

groups {
movers = Chain Left Right UpMover
}

sprites {
Chain
#2563eb #dbeafe
00100
00010
11111
00010
00100

Left
#16a34a #dcfce7
00100
01000
11111
01000
00100

Right
#dc2626 #fee2e2
00100
01000
11111
01000
00100

UpMover
#9333ea #f3e8ff
00100
01110
10101
00100
00100

Wall
#334155 #cbd5e1
10101
01010
10101
01010
10101
}

sounds {
move movers -> sfx move
}

rules {
input right [ Chain ] -> [ > Chain ]
input right [ Left ] -> [ > Left ]
input right [ Right ] -> [ < Right ]
input right [ UpMover ] -> [ ^ UpMover ]
move
}
}

levels test of move_collision {
legend {
. = empty
C = Chain
L = Left
R = Right
U = UpMover
# = Wall
}

level "chain" {
CC.
}

level "head_on" {
L.R
}

level "corner" {
L.
.U
}

level "three_way" {
L.R
.U.
}

level "wall_block" {
L#
}

level "cantmove_plus_move" {
L#.C.
}
}

scene title {
title = title
choice "Play" -> goto playing
choice "Level Select" -> goto level_select
}

scene playing {
layout {
row {
title = title
subtitle = level.label
}
move_collision
}
keys {
q Escape -> level_select
}
rules {
step move_collision
}
routine level_select {
goto level_select
}
}

scene level_select {
layout {
text "Select a level"
level_menu
button "Back" -> goto title
}
keys {
q Escape -> back_to_title
}
routine back_to_title {
goto title
}
}
