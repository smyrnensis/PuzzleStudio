title "Move Collision Test"
author "PuzzleStudio"

default_wait_time = 100ms

sounds {
	sfx move seed=move type=jump
	sfx bump seed=bump type=hit
}

puzzle move_collision {
	layers {
		actor = Chain Left Right UpMover Wall
	}

	group movers = Chain Left Right UpMover

	sprites {
		Chain {
			#2563eb #dbeafe
			00100
			00010
			11111
			00010
			00100
		}

		Left {
			#16a34a #dcfce7
			00100
			00010
			11111
			00010
			00100
		}

		Right {
			#dc2626 #fee2e2
			00100
			01000
			11111
			01000
			00100
		}

		UpMover {
			#9333ea #f3e8ff
			00100
			01110
			11111
			00100
			00100
		}

		Wall {
			#334155 #cbd5e1
			10101
			01010
			10101
			01010
			10101
		}
	}

	sounds {
		move movers -> sfx move
		cantmove movers -> sfx bump
	}

	rules {
		input right [ Chain ] -> [ > Chain ]
		input right [ Left ] -> [ > Left ]
		input right [ Right ] -> [ < Right ]
		input right [ UpMover ] -> [ ^ UpMover ]
		move
	}
}

levels test of move_collision {
	legend {
		. = empty
		C = Chain
		L = Left
		R = Right
		U = UpMover
		# = Wall
	}

	level chain {
		CC.
	}

	level head_on {
		L.R
	}

	level corner {
		L.
		.U
	}

	level three_way {
		L.R
		.U.
	}

	level wall_block {
		L#
	}

	level cantmove_plus_move {
		L#.C.
	}
}

scene title {
	title
	choice "Play" -> goto playing("test.chain")
	choice "Level Select" -> goto level_select
}

scene playing {
	state {
		board = puzzle move_collision
	}
	layout {
		row {
			title
			subtitle level.label
		}
		board
	}
	inputs {
		level_select <- q Escape
	}
	rules {
		step board
		level_select -> goto level_select
	}
}

scene level_select {
	layout {
		text "Select a level"
		level_menu
		button "Back" -> goto title
	}
	inputs {
		back_to_title <- q Escape
	}
	rules {
		back_to_title -> goto title
	}
}
