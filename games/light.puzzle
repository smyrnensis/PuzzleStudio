title = "light"

theme {
preset = "puzzlescript"
background_color = #fff
text_color = #000
}

puzzle main {

slots {
@base = @Floor
solid = Wall Player Crate Box Lump
effect = Light Dark
}

groups {
obstacle = Wall Crate Box
push = Crate Lump
multpush = Box Player
object = solid
}

routine light_effect {
[ effect ] -> [ ]
[ Lump | no obstacle ] -> [ Lump | Light ]
[ Light | no obstacle ] -> [ Light | Light ]
[ no Light no obstacle ] -> [ Dark ]
}

on_level_start {
light_effect
}

routine move {
repeat {
for d in directions {
d [ d object | no object no {__move_collision} ] -> [ | object{no directions} ]
}
for d in directions {
once_all d [ d object ] -> [ object ]
}
once_all [ {__move_collision} ] -> [ ]
}
}

rules {
input [ Player ] -> [ > Player ]
[ >  Player | push ] -> [  >  Player | > push  ]
[ > solid | multpush ] -> [ > solid | > multpush ]
move
light_effect
}

visuals {
@Floor
#eeeeee

Wall
#001111

Player
#000000
.000.
.000.
00000
.000.
.0.0.

Crate
#f3a002 #b38002
00000
01110
01110
01110
00000

Lump
#363535 #ffffcc
..0..
.000.
.111.
.111.
00000

Light
#ffffff55

Dark
#000000aa
}

levels {
legend {
. = empty
# = Wall
* = Crate
P = Player
@ = Lump
}
#########
#...*...#
#...*...#
#.P.*...#
#.@.*...#
#...*...#
#########
}

}

scene title {
layout {
heading title
choice "Start" -> goto main
choice "Levels" -> goto level_select
}

keys {
Enter Space -> goto playing
l -> goto level_select
}
}

scene playing {
layout {
puzzle board = main
}
keys {
Escape q -> goto title
}
rules {
step board
}
}

scene level_select {
layout {
text "Select Level"
level_menu
button "Back" -> goto title
}

keys {
Escape q -> goto title
}
}
