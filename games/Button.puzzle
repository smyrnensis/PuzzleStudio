title "Microban Basic 3D"

model puzzle3 microban3d {
  debug_camera = false
  camera_yaw = 15
  camera_pitch = 55
  camera_zoom = 1.1

  layers {
    floor = Floor
    target = Goal
    solid = Player Box Wall
  }

  group solid = Player Box Wall

  rules {
    input horizontal [ Player | Box | no solid ] -> [ | Player | Box ]
    input horizontal [ Player | no solid ] -> [ | Player ]
  }

  win_conditions {
    some Goal
    all Goal on down [ Box | Goal ]
  }

  on_level_clear {
    next_level
  }
}

scene title {
  view {
    title "Microban Basic 3D"
    button "Start" -> start microban in playing
    button "Level Select" -> goto level_select
  }
}

scene level_select {
  state {
    puzzle3 microban3d
  }

  view {
    title "Select Level"
    level_menu
    button "Back" -> goto title
  }
}

scene playing {
  state {
    puzzle3 microban3d
  }

  keys {
    q -> goto level_select
    Escape -> goto level_select
  }

  rules {
    step microban3d
  }

  view {
    box size 8 8 {
      puzzle3 board size 7 7
    }
  }
}

levels3 microban of microban3d {
  legend {
    _ = empty
    . = Floor
    G = Floor Goal
    P = Player
    B = Box
    # = Wall
  }

  level microban_01 {
    ####__
    #__#__
    #__###
    #BP__#
    #__B_#
    #__###
    ####__

    ......
    ..G...
    ......
    .G....
    ......
    ......
    ......
  }

  level microban_02 {
    ######
    #____#
    #_#P_#
    #_BB_#
    #__B_#
    #____#
    ######

    ......
    ......
    ......
    ...G..
    ..GG..
    ......
    ......
  }

  level microban_03 {
    __####___
    ###__####
    #_____B_#
    #_#__#B_#
    #____#P_#
    #########

    .........
    .........
    .........
    .........
    ..G.G....
    .........
  }
}

