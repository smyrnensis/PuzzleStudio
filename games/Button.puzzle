title "Microban 3D"
author "Levels by David Skinner"

theme puzzlescript

puzzle3 sokoban {
render {
  camera {
    yaw = 10
    pitch = 55
    zoom = 1.1
  }
}

layers {
  floor = Floor
  target = Goal
  solid = Player Box Wall
}

group {
  solid = Player Box Wall
}

rules {
  input [ Player ] -> [ > Player ]
}

win_conditions {
  some Goal
  no down [ no Box | Goal ]
}

on_level_clear {
  next_level
}
}

scene title {
layout {
  title "Microban 3D"
  button "New Game" -> goto playing
  button "Level Select" -> goto level_select
}
}

scene playing {
state {
  puzzle3 sokoban
}
keys {
q Escape -> goto level_select	
}
rules {
  step sokoban
}

layout {
  row {
    title "Microban 3D"
  }
  puzzle3 sokoban size 8 8
}
}

scene level_select {
layout {
  title "Select Level"
  column scroll=true {
    for level in levels {
      choice join(level.num, ". ", level.title) -> goto sokoban(level)
    }
  }
  button "Exit" -> goto title
}
}

levels3 microban of sokoban {
legend {
. = empty
, = Floor
G = Floor Goal
P = Player
B = Box
# = Wall
}

