title "Wide Floor 3D"
author "PuzzleStudio"

puzzle3 wide_floor {
  render {
    camera yaw=34 pitch=38 zoom=1 interactive_look
    viewport {
      smoothscreen 9 7
      focus Player
    }
  }

  layers {
    floor = FloorA FloorB
    actor = Player
  }

  rules local_frame 12 12 full {
    input horizontal [ Player | no Player ] -> [ | Player ]
  }
}

sprites3 simple of wide_floor {
FloorA
#c8d7bd

FloorB
#93ad86

Player
#d94132
}

scene title {
  layout {
    title "Wide Floor 3D"
    button "Start" -> goto wide_floor
  }
}

levels3 test of wide_floor {
  legend {
    . = empty
    a = FloorA
    b = FloorB
    P = Player
