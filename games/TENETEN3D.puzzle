puzzle TENETEN {
dimension = 3

render {
camera {
yaw = 0
pitch = 50
zoom = 1
}
tween = true
shadow = true
}


layers {
floor = Floor Floor2 Pond
solid = TEN:time:horizontal Crate Forest Forest2
}

tags {
time = B F
}

rules {
input [ TEN:*:* ] -> [ > TEN:*:* ]
[ > TEN:*:* ]  -> [ > TEN:*:> ]
[ > TEN:F:> | Crate ] -> [ > TEN:F:> | > Crate ]
[ < TEN:B:< | Crate ] -> [ < TEN:B:< | < Crate ]
[ > solid | no solid ] -> [  | solid ]
}
}

levels {
legend {
F = TEN:F:front
C = Crate
. = empty
B = TEN:B:front
# = Forest
G = Floor
P = Pond
}

