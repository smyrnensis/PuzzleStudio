    #_#P_#
    #_BB_#
    #__B_#
    #____#
    ######

    ......
    ......
    ......
    ...G..
    ..GG..
    ......
    ......
  }

  level microban_03 {
    __####___
    ###__####
    #_____B_#
    #_#__#B_#
    #____#P_#
    #########

    .........
    .........
    .........
    .........
    ..G.G....
    .........
  }
}

