title "Microban Basic 3D"

puzzle3 sokoban_literally_in_3d {
  render {
    camera {
      yaw = 15
      pitch = 55
      zoom = 1.1
      interactive_look = true
      interactive_zoom = true
    }
    grid {
      occupied_cells = true
    }
  }

  layers {
    floor = Floor
    target = Goal
    solid = Player Box Wall
  }

  group solid = Player Box Wall

  rules {
    input horizontal [ Player | Box | no solid ] -> [ | Player | Box ]
    input horizontal [ Player | no solid ] -> [ | Player ]
  }

  win_conditions {
    some Goal
    no down [ no Box | Goal ]
  }

  on_level_clear {
    if win_conditions -> next_level
  }
}

scene title {
  view {
    title "Microban Basic 3D"
    button "New Game" -> start microban in playing
    button "Level Select" -> goto level_select
  }
}

scene level_select {
  state {
    board = puzzle3 sokoban_literally_in_3d
  }

  view {
    title "Select Level"
    level_menu microban -> start microban in playing
    button "Back" -> goto title
  }
}

scene playing {
  state {
    board = puzzle3 sokoban_literally_in_3d
  }

  keys {
    q = goto level_select
    Escape = goto level_select
  }

  rules {
    board.rules
  }

  view {
    box size 4 3 {
      puzzle3 board size 4 3
    }
  }
}

levels3 microban of sokoban_literally_in_3d {
  legend {
    _ = empty
    . = Floor
    G = Floor Goal
    P = Player
    B = Box
    # = Wall
  }

  level microban_01 {
    ####__
