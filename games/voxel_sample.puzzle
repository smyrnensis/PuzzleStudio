title "voxel_sample"

puzzle3 main {
	layers {
		floor = Goal
		solid = Player Wall
	}


	win_conditions {
		exists(Goal)
		none([ Goal no Player ])
	}

	rules {
		input [ Player ] -> [ > Player ]
	}

	levels {
		legend {
			. = empty
			# = Wall
			P = Player
			G = Goal
			+ = Player Goal
		}

		level level_1
			#######
			#P...G#
			#######

		level level_2
			#######
			#P....#
			#..G..#
			#######

		level new_level
			.........
			.........
			.........
			.........
			.........
}
}

scene playing {
	state {
		puzzle main
	}
	layout size 4 3 {
		column gap 1 align center top {
			title
			main
		}
	}
	rules {
		step main
	}
}

