title = "Microban 3D"
author = "Levels by David Skinner"

theme = "puzzlescript"

puzzle sokoban {
render {
camera {
	yaw = 0
	pitch = 90
		zoom = 1
}
	shadow = true
}

layers {
floor = Floor
target = Goal
Player Box Wall
}

groups {
solid = Player Box Wall
}

rules {
input horizontal [ Player | Box | no solid ] -> [ | Player | Box ]
input horizontal [ Player | no solid ] -> [ | Player ]
}

win_conditions {
some Goal
no down [ no Box | Goal ]
}

on_level_clear {
if win_conditions -> next_level
}

on_last_level_clear {
message "END"
goto title
}
}

scene title {
layout {
  heading "Microban 3D"
  choice "New Game" -> goto playing
  choice "Level Select" -> goto level_select
}
}

scene playing {
keys {
q Escape -> goto level_select	
}
layout {
heading "Microban 3D"
sokoban
}
rules {
step sokoban
}
}

scene level_select {
layout {
  heading "Select Level"
  column scroll=true {
    for level in microban {
      choice join("microban ", level.num) -> goto sokoban(level)
    }
  }
  button "Exit" -> goto title
}
}

levels microban of sokoban {
legend {
, = Floor
G = Floor Goal
P = Player
B = Box
# = Wall
}

level "microban 1" {
####..
