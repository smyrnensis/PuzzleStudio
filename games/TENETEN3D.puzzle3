puzzle TENETEN {
dimension = 3

render {
camera {
yaw = 0
pitch = 90
zoom = 1
}
shadow = true
}

slots {
floor = Floor Floor2
solid = TEN:horizontal
}


rules {
input [ TEN:horizontal ] -> [ > TEN:horizontal ]
for h in horizontal {
if input == h {
[ > TEN:horizontal ] -> [ > TEN:h ]
}
}
[ > TEN:horizontal | ] -> [  | TEN:horizontal ]
}
}

