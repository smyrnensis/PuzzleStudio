puzzle TENETEN {
dimension = 3

render {
camera {
yaw = 0
pitch = 30
zoom = 1
}
tween = true
shadow = true
}


slots {
floor = Floor Floor2
solid = TEN:horizontal
}

on_level_start {
down [ no Floor | null ] -> [ Floor | null ]
}

rules {
input [ TEN:* ] -> [ > TEN:* ]
for h in horizontal {
if input == h {
[ > TEN:horizontal ] -> [ > TEN:h ]
}
}
[ > TEN:horizontal | ] -> [  | TEN:horizontal ]
}
}

levels {
legend {
T = TEN:front
. = empty
F = Floor
}

