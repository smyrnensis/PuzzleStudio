puzzle TENETEN {
dimension = 3

render {
camera {
yaw = 0
pitch = 50
zoom = 1
}
tween = true
tween_duration = 300ms
shadow = true
}


layers {
floor = Floor Floor2
solid = TEN:horizontal Crate Forest
}

on_level_start {
down [ no Floor | null ] -> [ Floor | null ]
}

rules {
input [ TEN:* ] -> [ > TEN:* ]
[ > TEN:* ]  -> [ > TEN:> ]
[ > TEN:> | Crate ] -> [ > TEN:> | > Crate ]
[ > solid | no solid ] -> [  | solid ]
}
}

levels {
legend {
T = TEN:front
C = Crate
. = empty
F = Floor
# = Forest
}

