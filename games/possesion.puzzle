sounds {
music possesion { seed = 517275; bars = 8; height = 0.50; bpm = 100; volume = 0.50 }
}

puzzle possesion {

tags {
state = norm poss
}

layers {
@Floor @Floor2
Wall Alien Crab:state
each @LockedFrame:directions @LockedCorner:directions
each @WallFrame:directions @WallCorner:directions
Stop
}

groups {
playable = Alien *:poss
solid = Crab:*
}

routine @initial_displays {
once [ no @Floor ] -> [ @Floor ]
repeat {
[ @Floor | no @Floor2 ] -> [ @Floor | @Floor2 ]
[ @Floor2 | no @Floor ] -> [ @Floor2 | @Floor ]
}
[ Wall | no Wall ] -> [ Wall @WallFrame:> |  ]
[ Wall | Wall ; Wall | no Wall ] -> [ Wall @WallCorner:> | Wall ; Wall |  ]
}

on_level_start {
@initial_displays
}

rules {
input [ playable ] -> [ > playable ]
[ > Alien | Crab:norm ] -> [  | Crab:poss ]
[ > Crab:poss | Crab:norm ] -> [ > Crab:poss | > Crab:norm ]
[ Wall ] -> [ Wall Stop ]
[ > solid | Stop ] -> [ > solid Stop | Stop ]
[ > *:poss | Crab:norm Stop ] -> [ *:norm | Crab:poss Stop ]
[ Stop ] -> [  ]
move
}

