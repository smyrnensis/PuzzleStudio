title = "Microban"
author = "Levels by David Skinner"

theme = "puzzlescript"

puzzle sokoban {
layers {
Background
Goal
solid = Player:directions Box Wall
}

render {
tween = true
tween_duration = 0.1s
}

win_conditions {
some [ Goal ]
no [ Box no Goal ]
}

on_level_start {
once_all [ no Background ] -> [ Background ]
}

rules {
input [ Player:* ] -> [ > Player:> ] 
[ > Player:> | Box ] -> [ > Player:> | > Box ]
[ > solid | no solid ] -> [  | solid ] 
[ > solid ] -> [ solid ]
}

on_level_clear {
wait 0.30s
next_level
}
}

visuals {

visual {
selector = Background
colors = #90ee90 #008000
duration = 500ms
11111
01111
11101
11111
10111
}

visual {
selector = Wall
colors = #a46322 #493c2b
duration = 500ms
00010
11111
01000
11111
00010
}

Goal
#00008b
.....
.000.
.0.0.
.000.
.....

Box
#ffa500 #ffff00
00000
0...0
0...0
0...0
00000

visual {
selector = Player:directions
rotate directions from up
colors = #000000 #ffa500 #ffffff #0000ff
.000.
.111.
22222
.333.
.3.3.
}
}

levels microban of sokoban {
legend {
. = empty
G = Goal
P = Player:up
B = Box
# = Wall
* = Goal Box
+ = Goal Player:up
}

