title = "Microban"
author = "Levels by David Skinner"

theme = "puzzlescript"

puzzle sokoban {
layers {
Background
Goal
solid = Player Box Wall
}

win_conditions {
some [ Goal ]
no [ Box no Goal ]
}

on_level_start {
once_all [ no Background ] -> [ Background ]
}

rules {
input [ Player ] -> [ > Player ] 
[ > Player | Box ] -> [ > Player | > Box ]
move
}

on_level_clear {
wait 0.30s
next_level
}
}

