sounds {
move push -> sfx push_move
restart -> sfx restart
undo -> sfx undo
}

win_conditions {
no ring
}

routine move {
repeat {
for l in layer1 layer2 layer3 layer4 layer5 layer6 layer7 layer8 layer9 layer10 layer11 layer12 layer13 layer14 layer15 layer16 layer17 layer18 layer19 layer20 layer21 layer22 layer23 layer24 layer25 layer26 layer27 layer28 layer29 layer30 layer31 {
once_all [ > l | | < l ] -> [ l | {__move_collision} | l ]
once_all [ > l | ; | ^ l ] -> [ l | {__move_collision} ; | l ]
[ > l | no l no {__move_collision} ] -> [ | l{no directions} ]
once_all [ > l ] -> [ l ]
}
once_all [ {__move_collision} ] -> [ ]
}
}

routine main {
up [ Start ] [ Ice | ] -> [ Start ] [ Ice | IceAboveEdge ]
up [ Start ] [ OrangeBlock | ] -> [ Start ] [ OrangeBlock | OrangeAboveEdge ]
up [ Start ] [ BlackBlock | ] -> [ Start ] [ BlackBlock | BlackAboveEdge ]
up [ Start ] [ PurpleBlock | ] -> [ Start ] [ PurpleBlock | PurpleAboveEdge ]
up [ Start ] [ GreenBlock | ] -> [ Start ] [ GreenBlock | GreenAboveEdge ]
up [ Start ] [ BrownBlock | ] -> [ Start ] [ BrownBlock | BrownAboveEdge ]
up [ Start ] [ BlackBox | ] -> [ Start ] [ BlackBox | BlackAboveEdge ]
up [ Start ] [ OrangeBox | ] -> [ Start ] [ OrangeBox | OrangeAboveEdge ]
up [ Start ] [ PurpleBox | ] -> [ Start ] [ PurpleBox | PurpleAboveEdge ]
up [ Start ] [ GreenBox | ] -> [ Start ] [ GreenBox | GreenAboveEdge ]
up [ Start ] [ WhiteBox | ] -> [ Start ] [ WhiteBox | WhiteAboveEdge ]
up [ Start ] [ BrownBox | ] -> [ Start ] [ BrownBox | BrownAboveEdge ]
up [ Start ] [ BlueBox | ] -> [ Start ] [ BlueBox | BlueAboveEdge ]
down [ Start ] [ Water | Water no WaterEdge ] -> [ Start ] [ Water | Water WaterEdge ]
