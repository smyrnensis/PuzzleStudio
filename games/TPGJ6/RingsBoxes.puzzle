title = "Rings and Boxes"
author = "smyrnensis"
homepage = "https:"

theme {
preset = "puzzlescript"
background_color = #654
}

sounds {
sfx sfx1 { seed = 56594500; type = puzzlescript }
sfx sfx2 { seed = 18946302; type = puzzlescript }
sfx sfx4 { seed = 64260708; type = puzzlescript }
sfx sfx5 { seed = 58821102; type = puzzlescript }
sfx sfx6 { seed = 24018504; type = puzzlescript }
sfx push_move { seed = 42952107; type = puzzlescript }
sfx restart { seed = 24001300; type = puzzlescript }
sfx undo { seed = 46965907; type = puzzlescript }
sfx endlevel { seed = 98393900; type = puzzlescript }
}

scene title {
layout {
heading "Rings and Boxes"
subheading "by smyrnensis"
if has_progress_save {
choice "Continue" -> {
goto playing
}
}
choice "New Game" -> {
clear_game_progress
start playing
}
choice "Level Select" -> goto level_select
}
}

puzzle main {
slots {
layer1 = BlackFloor OrangeFloor PurpleFloor GreenFloor BrownFloor WhiteFloor
layer2 = BlackButton OrangeButton PurpleButton GreenButton BrownButton Crack Water
layer3 = WaterEdge FloorEdge WallEdge
layer4 = RingShadow
layer5 = BoxShadow IceShadow
layer6 = BlackBox OrangeBox PurpleBox GreenBox BrownBox WhiteBox BlueBox Ice BlackBlock OrangeBlock PurpleBlock GreenBlock BrownBlock
layer7 = BlackAboveEdge OrangeAboveEdge PurpleAboveEdge GreenAboveEdge BlueAboveEdge BrownAboveEdge WhiteAboveEdge IceAboveEdge
layer8 = JointLTag BlackJointL OrangeJointL PurpleJointL GreenJointL BrownJointL
layer9 = JointRTag BlackJointR OrangeJointR PurpleJointR GreenJointR BrownJointR
layer10 = JointUTag BlackJointU OrangeJointU PurpleJointU GreenJointU BrownJointU
layer11 = JointDTag BlackJointD OrangeJointD PurpleJointD GreenJointD BrownJointD
layer12 = BlackJointAboveEdge OrangeJointAboveEdge PurpleJointAboveEdge GreenJointAboveEdge BrownJointAboveEdge
layer13 = WaterMarker OrangeMarker PurpleMarker GreenMarker BlackMarker BrownMarker
layer14 = BlackMarker2 OrangeMarker2 PurpleMarker2 GreenMarker2 BrownMarker2
layer15 = BlackRing OrangeRing PurpleRing GreenRing BrownRing
layer16 = StopFlag
layer17 = CloseFlag OpenFlag
layer18 = BreakFlag FallFlag
layer19 = BlockFlag
layer20 = ExchangeFlag ConvertFlag
layer21 = ExchangeTriggered ExchangeTrigger
layer22 = Start
layer23 = RigidTag RigidTag2
layer24 = NotLowest
layer25 = LStack
layer26 = RStack
layer27 = UStack
layer28 = DStack
layer29 = Lose
layer30 = Click
layer31 = Quit
}

groups {
player = BlackRing
background = WhiteFloor
box = BlackBox OrangeBox PurpleBox GreenBox BrownBox WhiteBox BlueBox
ring = BlackRing OrangeRing PurpleRing GreenRing BrownRing
coloredring = OrangeRing PurpleRing GreenRing BrownRing
block = BlackBlock OrangeBlock PurpleBlock GreenBlock BrownBlock
floor = BlackFloor OrangeFloor PurpleFloor GreenFloor BrownFloor WhiteFloor
button = BlackButton OrangeButton PurpleButton GreenButton BrownButton
push = box Ice
heavy = push block
edge = BlackAboveEdge OrangeAboveEdge PurpleAboveEdge GreenAboveEdge BlueAboveEdge BrownAboveEdge WhiteAboveEdge IceAboveEdge
jointL = BlackJointL OrangeJointL PurpleJointL GreenJointL BrownJointL
jointR = BlackJointR OrangeJointR PurpleJointR GreenJointR BrownJointR
jointU = BlackJointU OrangeJointU PurpleJointU GreenJointU BrownJointU
jointD = BlackJointD OrangeJointD PurpleJointD GreenJointD BrownJointD
joint = jointL jointR jointU jointD
jointedge = BlackJointAboveEdge OrangeJointAboveEdge PurpleJointAboveEdge GreenJointAboveEdge BrownJointAboveEdge
marker = WaterMarker OrangeMarker PurpleMarker GreenMarker BlackMarker BrownMarker
marker2 = BlackMarker2 OrangeMarker2 PurpleMarker2 GreenMarker2 BrownMarker2
stack = LStack RStack DStack UStack
}

