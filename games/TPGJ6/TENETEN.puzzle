sounds {
move player -> sfx player_move
move Crate -> sfx crate_move
restart -> sfx restart
undo -> sfx undo
}

win_conditions {
no [ TargetCrate no crate ]
no [ TargetBall no Ball ]
no [ TargetYou no You:D ]
no [ TargetFly no Fly ]
no [ TargetHeadlong no Headlong ]
}

routine move {
repeat {
for l in layer1 layer2 layer3 layer4 layer5 layer6 layer7 layer8 Boundary:directions Corner:directions layer9 layer10 layer11 layer12 layer13 layer14 layer15 NotEdge:directions Marker:directions layer16 layer17 layer18 layer19 layer20 layer21 layer22 {
once_all [ > l | | < l ] -> [ l | {__move_collision} | l ]
once_all [ > l | ; | ^ l ] -> [ l | {__move_collision} ; | l ]
[ > l | no l no {__move_collision} ] -> [ | l{no directions} ]
once_all [ > l ] -> [ l ]
}
once_all [ {__move_collision} ] -> [ ]
}
}

routine BallPush once {
[ > object | Ball | stopper ] -> CancelTurn
[ > object | Ball | no stopper ] -> [ > object | | Ball Moment:> ] sfx sfx1
[ Ball Moment:> | no stopper ] -> [ | Ball Moment:> ]
[ Ball Moment:> | stopper ] -> [ Ball | stopper ]
[ Moment:> ] -> [ ]
}

routine BallPull once {
[ < object | no stopper ] -> [ < object | Marker:< ]
[ Marker:< | no stopper ] -> [ Marker:< | Marker:< ]
[ Marker:< | ball | stopper ] -> [ Marker:< | Ball Moment:< | stopper ]
[ Marker:< | Ball Moment:< ] -> [ Ball Moment:< | ]
[ < object | Ball Moment:< ] -> [ < object | < Ball ] sfx sfx1
[ < object | ball | stopper ] -> [ < object | < Ball | stopper ] sfx sfx1
[ Moment:> ] -> [ ]
[ Marker:> ] -> [ ]
[ Computer ] -> [ Computer OnlyOneButton ]
[ Computer ] [ Button heavy ] -> [ Computer ] [ Button heavy Checked ]
[ OnlyOneButton ] [ Button heavy Checked ] [ Button heavy no Checked ] -> [ ] [ Button heavy ] [ Button heavy ]
[ Checked ] -> [ ]
[ < object | no stopper ] -> [ < object | Marker:< ]
[ Marker:< | no stopper ] -> [ Marker:< | Marker:< ]
[ OnlyOneButton ] [ Marker:< | ball Button | GateO ] -> [ OnlyOneButton ] [ Marker:< | Ball Moment:< Button | GateO ]
[ Marker:< | Ball Moment:< ] -> [ Ball Moment:< | ]
[ < object | Ball Moment:< ] -> [ < object | < Ball ] sfx sfx1
[ OnlyOneButton ] [ < object | ball Button | GateO ] -> [ OnlyOneButton ] [ < object | < Ball Button | GateO ] sfx sfx1
[ OnlyOneButton ] -> [ ]
[ Marker:> ] -> [ ]
[ Moment:> ] -> [ ]
}

routine HeadlongCome once {
[ stopper | Headlong | no stopper ] -> [ stopper | Headlong | Marker:> ]
[ Marker:> | no stopper ] -> [ Marker:> | Marker:> ]
[ ^ You:B | Marker:< | ... | Headlong ] -> [ ^ You:B | Headlong | ... | ] sfx sfx1
[ v You:B | Marker:< | ... | Headlong ] -> [ v You:B | Headlong | ... | ] sfx sfx1
[ < You:B | Marker:< | ... | Headlong ] -> [ < You:B | Headlong | ... | ] sfx sfx1
[ Marker:> ] -> [ ]
}

routine CancelTurn once {
[ Computer ] -> [ Computer CancelTurn ] sfx sfx3
[ > You:D | ] -> [ You:D | NoGo ]
[ > object ] -> [ object ]
}

routine Start once {
[ Start ] [ no Start ] -> [ Start ] [ Start ]
[ Start | Start ] -> [ Start NotEdge:> | Start NotEdge:< ]
[ Start no NotEdge:up no NotEdge:left ] -> [ Start Computer ]
[ NotEdge:directions ] -> [ ]
[ Start no Computer ] -> [ ]
repeat {
[ Start Background no Background2 | no Start Background ] -> [ Start Background | Start Background Background2 ]
[ Start Background2 | no Start Background ] -> [ Start Background2 | Start Background ]
}
[ Start no Computer ] -> [ ]
[ Boundary:> ] -> [ ]
[ Corner:> ] -> [ ]
[ Wall no Boundary:> | no Wall ] -> [ Wall Boundary:> | ]
[ Wall no Boundary:^ | Boundary:^ ] -> [ Wall Corner:^ | Boundary:^ ]
[ Wall no Boundary:v | Boundary:v ] -> [ Wall Corner:> | Boundary:v ]
down [ Wall | no Wall ] -> [ Wall | WallShadow ]
[ Computer ] [ You:D#1 ] -> [ Computer Time:D#1 ] [ You:D#1 ]
[ Start ] -> [ ]
}

routine FlipTimeDirection once {
[ You:D#1 Ink:D_rev(D#1) ] -> [ You:D_rev(D#1) Ink:D_rev(D#1) ] sfx sfx0
[ You:D#1 Count:N#2 no Checked ] -> [ You:D_rev(D#1) Count:Nm(N#2) Checked ] sfx sfx0
[ Count:0 ] -> [ ]
[ Checked ] -> [ ]
[ Computer ] [ You:D#1 ] -> [ Computer Time:D#1 ] [ You:D#1 ]
}

routine main once {
[ Start ] -> Start
[ NoGo ] -> [ ]
[ > You:F | nogoF ] -> CancelTurn
[ > You:B | nogoB ] -> CancelTurn
[ > You:F | water no objectW ] -> CancelTurn
[ > You:B | Pond no objectW ] -> CancelTurn
[ ^ You:B | Headlong | no stopper ] -> CancelTurn
[ v You:B | Headlong | no stopper ] -> CancelTurn
[ < You:B | Headlong | no stopper ] -> CancelTurn
[ Computer no CancelTurn ] -> HeadlongCome
[ > You:F | push ] -> [ > You:F | > push ]
[ < You:B | push ] -> [ < You:B | < push ]
[ > push | push ] -> [ > push | > push ]
[ < push | push ] -> [ < push | < push ]
[ > push | Fly ] -> [ > push | Fly ] CancelTurn
[ < You:F | Fly ] -> [ < You:F | < Fly ]
[ > You:B | Fly ] -> [ > You:B | > Fly ]
[ > You:B | | Fly ] -> CancelTurn
[ > Fly | Crate ] -> CancelTurn
[ > Fly | Fly ] -> CancelTurn
[ > Fly | Ball ] -> CancelTurn
[ Time:F ] -> BallPush
[ Time:B ] -> BallPull
[ > You:B | GateC ] -> [ > You:B | GateO ]
[ > You:B | ... | > Fly | GateC ] -> [ > You:B | ... | > Fly | GateO ]
[ > heavy | Button ] [ Computer ] -> [ > heavy | Button ] [ Computer OpenFlag ]
[ Computer no OpenFlag ] [ no push no Ball no objectW | > You:B GateO ] -> CancelTurn
[ Computer no OpenFlag ] [ push{no directions} | > You:B GateO ] -> CancelTurn
[ Computer no OpenFlag ] [ Ball{no directions} | > You:B GateO ] -> CancelTurn
[ Computer no OpenFlag ] [ objectW{no directions} | > You:B GateO ] -> CancelTurn
[ Computer no OpenFlag ] [ no crate no Ball no objectW | > object GateO | ... | > You:B ] -> [ Computer ] [ | object GateO | ... | > You:B ]
[ Computer no OpenFlag ] [ Ball{no directions} | > object GateO | ... | > You:B ] -> [ Computer ] [ | object GateO | ... | > You:B ]
[ > You:D#1 | TimeMachine:D_rev(D#1) | cantpush ] -> [ > You:D_rev(D#1) | | cantpush ] sfx sfx0
[ > You:D#1 | TimeMachine:D#1 | cantpush ] -> [ > You:D#1 | | cantpush ] sfx sfx4
[ > object | Wall ] -> CancelTurn
[ > object | GateC ] -> CancelTurn
[ Crack > You:F ] -> [ Puddle > You:F ] sfx sfx4
[ > You:B | Puddle no objectW ] -> [ > You:B | Crack ] sfx sfx4
[ CrateW no object | > You:B ] -> [ > Crate | > You:B ]
[ CrateW no object | > Crate no water | ... | > You:B ] -> [ > Crate | > Crate | ... | > You:B ]
move
[ You:F | Headlong | no stopper ] -> [ You:F | Headlong Moment:> | ] sfx sfx1
[ Headlong Moment:> | no stopper ] -> [ | Headlong Moment:> ] sfx sfx1
[ Moment:directions ] -> [ ]
[ Computer no CancelTurn ] -> FlipTimeDirection
[ CancelTurn ] -> [ ]
[ Crate water no objectW ] -> [ CrateW water ] sfx sfx5
[ Ball water no objectW ] -> [ BallW water ] sfx sfx5
[ Crate FallFlag ] -> [ ] sfx sfx5
[ Ball FallFlag ] -> [ ] sfx sfx5
[ Crate Hole ] -> [ Crate Hole FallFlag ] again
[ Ball Hole ] -> [ Ball Hole FallFlag ] again
[ OpenFlag ] -> [ ]
[ GateO no object ] -> [ GateC ]
[ Button heavy ] [ GateC ] -> [ Button heavy ] [ GateO ]
[ Button heavy ] [ Computer ] -> [ Button heavy ] [ Computer OpenFlag ]
[ TargetYou You:D ] -> [ TargetYou You:D Satisfied ]
[ TargetYou no You:D Satisfied ] -> [ TargetYou ]
[ TargetCrate crate ] -> [ TargetCrate crate Satisfied ]
[ TargetCrate no crate Satisfied ] -> [ TargetCrate ]
[ TargetBall Ball ] -> [ TargetBall Ball Satisfied ]
[ TargetBall no Ball Satisfied ] -> [ TargetBall ]
[ TargetFly Fly ] -> [ TargetFly Fly Satisfied ]
[ TargetFly no Fly Satisfied ] -> [ TargetFly ]
[ TargetHeadlong Headlong ] -> [ TargetHeadlong Headlong Satisfied ]
[ TargetHeadlong no Headlong Satisfied ] -> [ TargetHeadlong ]
}

on_level_start {
once_all [ no Background ] -> [ Background ]
main
}

rules {
input directions [ player ] -> [ > player ]
main
}

on_level_clear {
wait 0.3s
next_level
}

