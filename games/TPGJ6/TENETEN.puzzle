title = "TENETEN"
author = "smyrnensis"
homepage = "smyrnensis.itch.io"

theme {
preset = "puzzlescript"
background_color = #243
}

sounds {
sfx sfx0 { seed = 17551700; type = puzzlescript }
sfx sfx1 { seed = 75011107; type = puzzlescript }
sfx sfx2 { seed = 85372903; type = puzzlescript }
sfx sfx3 { seed = 47068304; type = puzzlescript }
sfx sfx4 { seed = 59023902; type = puzzlescript }
sfx sfx5 { seed = 18102904; type = puzzlescript }
sfx sfx6 { seed = 75615703; type = puzzlescript }
sfx sfx10 { seed = 84421108; type = puzzlescript }
sfx player_move { seed = 9405707; type = puzzlescript }
sfx crate_move { seed = 64059507; type = puzzlescript }
sfx restart { seed = 24001300; type = puzzlescript }
sfx undo { seed = 84443307; type = puzzlescript }
sfx endlevel { seed = 91940500; type = puzzlescript }
}

puzzle main {
tags {
N = 0 1 2 3 Inf
D = F B
}

map Nm N {
0 -> 3
1 -> 0
2 -> 1
3 -> 2
Inf -> Inf
}

map D_rev D {
F -> B
B -> F
}

slots {
layer1 = Background
layer2 = Pond Puddle Crack Hole
layer3 = Background2
layer4 = TargetYou TargetCrate TargetBall TargetFly TargetHeadlong
layer5 = CrateW BallW Button GateO
layer6 = Satisfied
layer7 = Count:N Ink:D
layer8 = You:D Crate Ball Wall Fly Headlong TimeMachine:D GateC
each Boundary:directions
each Corner:directions
layer9 = WallShadow
layer10 = Star
layer11 = NoGo
layer12 = Checked
layer13 = Time:D
layer14 = Start
layer15 = Computer
each NotEdge:directions
each Marker:directions
layer16 = StopFlag
layer17 = CrackFlag
layer18 = CancelTurn
layer19 = OpenFlag
layer20 = OnlyOneButton
layer21 = Moment:directions
layer22 = FallFlag
}

groups {
player = You:D
object = player Crate Ball Wall Fly Headlong TimeMachine:D
stopper = player Crate Ball Wall Fly Headlong TimeMachine:D GateC
cantpush = Wall Fly GateC
push = Crate TimeMachine:D
objectW = CrateW BallW
water = Pond Puddle
nogoF = Wall Fly GateC Hole Headlong
nogoB = Wall Crate Crack Ball Hole Headlong
crate = Crate CrateW
ball = Ball BallW
heavy = player Crate Ball
counts = Count:N
targets = TargetYou TargetCrate TargetBall TargetFly TargetHeadlong
}

