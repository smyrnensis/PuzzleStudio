scene title {
	title
	subtitle
	choice "Play" -> goto playing
	// choice "New Game" -> {
			// clear_game_progress
			// goto playing
		// }
	choice "Levels" -> goto level_select
	on_scene_start {
		stop_music locked_room
	}
}

scene playing(level) {
	state {
		main
	}
	layout {
		main
	}
	keys {
		q Escape -> {
		stop_music locked_room
		goto level_select
		}
	}
	on_scene_start {
		play_music locked_room
	}
	rules {
		step main
	}
}


scene level_select {
			layout {
				text "Select a level"
				level_menu
				choice "Title" -> goto title
			}
		keys {
			q Escape -> goto title
		}
	on_scene_start {
		stop_music locked_room
	}
}
