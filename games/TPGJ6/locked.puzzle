scene title {
	title
	subtitle
	choice "Continue" -> goto playing
	choice "New Game" -> {
			clear_game_progress
			goto playing
		}
	choice "Level Select" -> goto level_select
	on_scene_start {
		stop_music locked_room
	}
}

scene playing(level) {
	state {
		sokoban
	}
	layout {
		row {
			title
			subtitle level.label
		}
		sokoban
	}
	keys {
		q Escape -> {
		stop_music locked_room
		goto level_select
		}
	}
	on_scene_start {
		play_music locked_room
	}
	rules {
		step board
	}
}


scene level_select {
			layout {
				text "Select a level"
				level_menu
				choice "Back" -> goto title
			}
		keys {
			q Escape -> goto title
		}
	on_scene_start {
		stop_music locked_room
	}
}
