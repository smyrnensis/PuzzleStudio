title "Microban Basic"
subtitle "Levels by David Skinner"
author "PuzzleStudio"
homepage "https://example.invalid/puzzlestudio"

default_wait_time = 100ms

const start_message = "Push every box onto a goal."
const final_message = "All Microban levels clear."

theme clean {
	accent_color #2f7d62
	background_color #f7f5ef
	text_color #1d2522
}

sounds {
	sfx push seed=boxpush01 type=hit
	sfx clear seed=clear01 type=jump
	music music_name seed=test1 tone=0 bpm=105 volume=0.5
}

puzzle sokoban {
	var box_moved = false

	layers {
		display_floor = @Floor
		target = Goal
		solid = Player Box Wall
	}

	sprites {
		@Floor {
			#90ee90 #008000
			11111
			01111
			11101
			11111
			10111
		}

		Wall {
			#a52a2a #654321
			00010
			11111
			01000
			11111
			00010
		}

		Goal {
			#00008b
			.....
			.000.
			.0.0.
			.000.
			.....
		}

		Box {
			#ffa500 #ffff00
			00000
			0...0
			0...0
			0...0
			00000
		}

		Player {
			#000000 #ffa500 #ffffff #0000ff
			.000.
			.111.
			22222
			.333.
			.3.3.
		}
	}

	win_conditions {
		some Goal
		all Goal on Box
	}

	routine @fill_floor repeat {
		[ no @Floor ] -> [ @Floor ]
	}

	on_display {
		@fill_floor
	}

	rules {
		once [ Player ] -> set box_moved = false
		for d in directions {
			if input == d {
				once d [ Player | Box | no solid ] -> [ | Player | Box ] set box_moved = true
				once d [ Player | no solid ] -> [ | Player ]
			}
		}
	}
}

levels microban of sokoban {
	legend {
		. = empty
		G = Goal
		P = Player
		B = Box
		# = Wall
		* = Goal Box
		+ = Goal Player
	}

	level microban_01 {
		####..
		#.G#..
		#..###
		#*P..#
		#..B.#
		#..###
		####..
	}

	level microban_02 {
		######
		#....#
		#.#P.#
		#.B*.#
		#.G*.#
		#....#
		######
	}

	level microban_03 {
		..####...
		###..####
		#.....B.#
		#.#..#B.#
		#.G.G#P.#
		#########
	}

	level microban_04 {
		########
		#......#
		#.G**BP#
		#......#
		#####..#
		....####
	}

	level microban_05 {
		.#######
		.#.....#
		.#.GBG.#
		##.BPB.#
		#..GBG.#
		#......#
		########
	}

	level microban_06 {
		######.#####
		#....###...#
		#.BB.....#P#
		#.B.#GGG...#
		#...########
		#####.......
	}

	level microban_07 {
		#######
		#.....#
		#.GBG.#
		#.BGB.#
		#.GBG.#
		#.BGB.#
		#..P..#
		#######
	}

	level microban_08 {
		..######
		..#.GGP#
		..#.BB.#
		..##.###
		...#.#..
		...#.#..
		####.#..
		#....##.
		#.#...#.
		#...#.#.
		###...#.
		..#####.
	}

	level microban_09 {
		#####.
		#G..##
		#PBB.#
		##...#
		.##..#
		..##G#
		...###
	}

	level microban_10 {
		......#####
		......#G..#
		......#G#.#
		#######G#.#
		#.P.B.B.B.#
		#.#.#.#.###
		#.......#..
		#########..
	}
}

scene title {
	title
	subtitle
	button "Continue" -> continue levels in playing
	button "New Game" -> start levels in playing
	button "Level Select" -> goto level_select
	on_scene_start {
		stop_music music_name
	}
}

scene playing {
	state {
		puzzle board
	}
	view {
		row {
			title
			subtitle
			subtitle level.label
		}
		board
	}
	inputs {
		open_menu <- Escape
		level_select <- q
	}
	on_scene_start {
		play_music music_name
		if level.name == microban.microban_01 {
			message start_message
		}
	}
	rules {
		step board
		input open_menu -> enter menu
		input level_select -> {
			stop_music music_name
			goto level_select
		}
		if board.win_conditions and board.level.last -> {
			sfx clear
			message final_message
			stop_music music_name
			goto level_select
		}
		if board.win_conditions -> {
			sfx clear
			wait 0.35s
			board.next_level
		}
		if board.box_moved -> sfx push
	}
}

scene menu {
	view {
		text "Menu"
		column {
			button "Resume" -> input resume
			button "Restart" -> playing.restart
			button "Level Select" -> goto level_select
		}
	}
	inputs {
		resume <- Escape Enter Space
		level_select <- q
	}
	rules {
		input resume -> {
			resume_music music_name
			back
		}
		input level_select -> {
			stop_music music_name
			goto level_select
		}
	}
}

scene level_select {
	view {
		text "Select a level"
		level_menu {
			show_index = true
			show_solved = true
			button "Back" -> goto title
		}
	}
	inputs {
		back_to_title <- q Escape
	}
	on_scene_start {
		stop_music music_name
	}
	rules {
		input back_to_title -> goto title
	}
}
