title "Microban Basic"
subtitle "Levels by David Skinner"
author "PuzzleStudio"
homepage "https://example.invalid/puzzlestudio"

default_wait_time = 100ms

const start_message = "Push every box onto a goal."
const final_message = "All Microban levels clear."

theme clean {
	accent_color #2f7d62
	background_color #f7f5ef
	text_color #1d2522
}

sounds {
	sfx push seed=push type=hit
	sfx bump seed=bump type=hit
	sfx clear seed=clear type=jump
	music music_name seed=test1 tone=0 bpm=105 volume=0.5
}

puzzle sokoban {
	layers {
		floor = Floor
		target = Goal
		solid = Player Box Wall
	}

	sprites {
		Floor {
			#90ee90 #008000
			11111
			01111
			11101
			11111
			10111
		}

		Wall {
			#a52a2a #654321
			00010
			11111
			01000
			11111
			00010
		}

		Goal {
			#00008b
			.....
			.000.
			.0.0.
			.000.
			.....
		}

		Box {
			#ffa500 #ffff00
			00000
			0...0
			0...0
			0...0
			00000
		}

		Player {
			#000000 #ffa500 #ffffff #0000ff
			.000.
			.111.
			22222
			.333.
			.3.3.
		}
	}

	sounds {
		move Box -> sfx push
		cantmove Box -> sfx bump
	}

	win_conditions {
		some Goal
		all Goal on Box
	}

	routine fill_floor repeat {
		[ no Floor ] -> [ Floor ]
	}

	on_level_start {
		fill_floor
	}

	on_level_clear {
		sfx clear
		wait 0.35s
		next_level
	}

	on_last_level_clear {
		sfx clear
		message final_message
	}

	rules {
		input directions [ Player ] -> [ > Player ]
		[ > Player | Box ] -> [ > Player | > Box ]
		move
	}
}

levels microban of sokoban {
	legend {
		. = empty
		G = Goal
		P = Player
		B = Box
		# = Wall
		* = Goal Box
		+ = Goal Player
	}

	message start_message
	####..
	#.G#..
	#..###
	#*P..#
	#..B.#
	#..###
	####..

	######
	#....#
	#.#P.#
	#.B*.#
	#.G*.#
	#....#
	######

	..####...
	###..####
	#.....B.#
	#.#..#B.#
	#.G.G#P.#
	#########

	########
	#......#
	#.G**BP#
	#......#
	#####..#
	....####

	.#######
	.#.....#
	.#.GBG.#
	##.BPB.#
	#..GBG.#
	#......#
	########

	######.#####
	#....###...#
	#.BB.....#P#
	#.B.#GGG...#
	#...########
	#####.......

	#######
	#.....#
	#.GBG.#
	#.BGB.#
	#.GBG.#
	#.BGB.#
	#..P..#
	#######

	..######
	..#.GGP#
	..#.BB.#
	..##.###
	...#.#..
	...#.#..
	####.#..
	#....##.
	#.#...#.
	#...#.#.
	###...#.
	..#####.

	#####.
	#G..##
	#PBB.#
	##...#
	.##..#
	..##G#
	...###

	......#####
	......#G..#
	......#G#.#
	#######G#.#
	#.P.B.B.B.#
	#.#.#.#.###
	#.......#..
	#########..
}

scene title {
	title
	subtitle
	choice "Continue" -> goto playing
	choice "New Game" -> input new_game
	choice "Level Select" -> goto level_select
	on_scene_start {
		stop_music music_name
	}
	rules {
		new_game -> {
			clear_game_progress
			goto playing("microban.1")
		}
	}
}

scene playing {
	state {
		board = puzzle sokoban
	}
	view {
		row {
			title
			subtitle
			subtitle level.label
		}
		board
	}
	inputs {
		open_menu <- Escape
		level_select <- q
	}
	on_scene_start {
		play_music music_name
	}
	rules {
		step board
		open_menu -> enter menu
		level_select -> {
			stop_music music_name
			goto level_select
		}
		if board.win_conditions and board.level.last -> {
			stop_music music_name
			goto level_select
		}
	}
}

scene menu {
	view {
		text "Menu"
		column {
			choice "Resume" -> input resume
			choice "Restart" -> playing.restart
			choice "Level Select" -> goto level_select
		}
	}
	inputs {
		resume <- Escape Enter Space
		level_select <- q
	}
	rules {
		resume -> {
			resume_music music_name
			back
		}
		level_select -> {
			stop_music music_name
			goto level_select
		}
	}
}

	scene level_select {
			view {
				text "Select a level"
				level_menu
				button "Back" -> goto title
			}
		inputs {
			back_to_title <- q Escape
		}
	on_scene_start {
		stop_music music_name
	}
	rules {
		back_to_title -> goto title
	}
}
