const title = "Wide Floor 3D"
const author = "PuzzleStudio"

puzzle wide_floor {
dimension = 3
  render {
    camera {
      yaw = 34
      pitch = 38
      zoom = 1
      interactive_look = true
      interactive_zoom = false
    }
    grid {
      type = "occupied_cells"
    }
    viewport {
      smoothscreen 9 7
      focus Player
    }
  }

  layers {
    floor = FloorA FloorB
    actor = Player
  }

  rules {
    input horizontal [ Player | no Player ] -> [ | Player ]
  }
}

visuals simple of wide_floor {
FloorA
#c8d7bd
0

FloorB
#93ad86
0

Player
#d94132
0
}

scene title {
  layout {
    heading "Wide Floor 3D"
    button "Start" -> goto playing
  }
}

scene playing {
  keys {
    Escape -> goto title
  }

  layout {
    wide_floor
  }

  rules {
    step wide_floor
  }
}

levels test of wide_floor {
  legend {
    . = empty
    a = FloorA
    b = FloorB
    P = Player
  }

