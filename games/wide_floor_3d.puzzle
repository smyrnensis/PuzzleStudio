title "Wide Floor 3D"
author "PuzzleStudio"

puzzle3 wide_floor {
  render {
    camera {
      yaw = 34
      pitch = 38
      zoom = 1
      interactive_look = true
      interactive_zoom = false
    }
    grid {
      occupied_cells = true
    }
    viewport {
      smoothscreen 9 7
      focus Player
    }
  }

  layers {
    floor = FloorA FloorB
    actor = Player
  }

  rules local_frame 12 12 full {
    input horizontal [ Player | no Player ] -> [ | Player ]
  }
}

sprites3 simple of wide_floor {
FloorA
#c8d7bd
0

FloorB
#93ad86
0

Player
#d94132
0
}

scene title {
  view {
    title "Wide Floor 3D"
    button "Start" -> goto playing
  }
}

scene playing {
  state {
    board = puzzle3 wide_floor
  }

  keys {
    Escape -> goto title
  }

  view {
    puzzle3 board
  }
}

levels3 test of wide_floor {
  legend {
    . = empty
    a = FloorA
    b = FloorB
    P = Player
  }

