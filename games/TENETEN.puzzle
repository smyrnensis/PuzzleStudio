scene title {
layout {
heading "TENETEN"
subheading "by smyrnensis"
if has_progress_save {
choice "Continue" -> {
goto playing
}
}
choice "New Game" -> {
clear_game_progress
start playing
}
choice "Level Select" -> goto level_select
}
}

scene playing {
layout {
row {
heading "TENETEN"
}
puzzle board = main
}
keys {
Escape q -> goto level_select
}
rules {
step board
}
}

scene level_select {
layout {
level_menu {
show_index = true
show_solved = true
button "Back" -> goto title
}
}
}
